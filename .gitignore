# A fork's own ./dev-sandbox settings (docs/sandbox.md); a fork that wants one commits it with -f.
/dev-sandbox.local

# The golden real-cache copy some suites read (src/test/helpers/real-cache.ts).
.test-cache/

# --- Generated by `npm run setup` (scripts/setup.ts) ------------------------------------------
# None of it is committed: setup rebuilds it from the pinned game cache, or downloads it against a
# SHA-256 pin (item icons, healthbars). See THIRD_PARTY_NOTICES.md.
/.setup-cache/
/public/osrs-cache/
# Interface sprites listed in scripts/assets/sprite-manifest.json.
/public/assets/ui/packs/
/public/assets/ui/*.png
/public/assets/ui/combat-styles/
/public/assets/ui/equipment/
/public/assets/ui/prayers/
/public/assets/ui/spells/
/public/assets/ui/status-bars/
/public/assets/encounters/
/public/*_click*.webp
/public/fonts/
/src/encounters/inferno/__tests__/fixtures/inferno-arena.json.gz
# RuneLite healthbars (scripts/assets/runeliteHealthbars.ts).
/public/assets/ui/healthbar/
# Item icons mirrored by scripts/fetch-item-icons.ts. scripts/item-icon-manifest.json IS
# committed: it holds the pins and is what the coverage test reads.
/public/assets/items/
