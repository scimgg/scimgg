#!/usr/bin/env bash
# dev-sandbox: run code you did not write (someone else's pull request, say) in a Docker sandbox:
# its dev server, tests, build or a shell. `./dev-sandbox --help` lists the commands.
#
# Threat model: the code runs as your non-root uid in containers with no network (only `npm ci`
# downloads), none of your files or credentials, and a read-only root; the dev server is reachable
# on 127.0.0.1 only, and opens in a separate browser profile. It does not stop a kernel or
# container escape, or the page's own JavaScript in that browser profile.
#
# Requires bash 3.2+, git 2.31+, curl and Docker Engine 25.0+ (rootful) on Linux, WSL2 or macOS.
# Run it from a checkout you trust: it never takes its own code from the code under test.
# Details, including the isolation self-test, seeds, disk use and limits: docs/sandbox.md.
#
# Portability: macOS's bash 3.2 and BSD tools, so no associative arrays, mapfile, ${x,,} or |&,
# every possibly empty array is expanded as ${a[@]+"${a[@]}"}, and nothing GNU-only (flock, ss,
# nproc, stat, bare sha256sum, GNU tar options). What needs GNU tools runs in a container.

set -euo pipefail

# =============================================================================================
# Config and constants

SANDBOX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
STATE="$HOME/.cache/scimgg-sandbox"
UPSTREAM_URL="${SCIMGG_SANDBOX_UPSTREAM:-https://github.com/scimgg/scimgg.git}"

# Official images, pinned by their multi-arch index digest, taken on 2026-11-27 (Node 24.22.3) with
#   docker pull node:24-bookworm-slim && docker image inspect --format '{{index .RepoDigests 0}}' node:24-bookworm-slim
# Snapshots run in an image built on it (dockerfile_text) that adds SANDBOX_APT_PACKAGES, because
# native modules build from source when their binary downloads have no network.
NODE_IMAGES="24=node@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530"
SANDBOX_APT_PACKAGES="python3 make g++"
SANDBOX_DOCKERFILE=""          # a fork's own Dockerfile instead of dockerfile_text (see docs)
# The self-test, relay, working-tree archives and seed downloads need only node: the plain base.
TOOLS_IMAGE="node@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530"

# inhibit_ipv4 on internal networks is what keeps the host off them; checked on engines 25.0.5,
# 26.1.4, 27.0.3 and 28.0.4 (docker:*-dind) and used end to end on 29.5.2.
MIN_DOCKER_MAJOR=25
MIN_DOCKER_MINOR=0
SELFTEST_VERSION=1             # bump when the flags the self-test checks change
SNAPSHOT_FORMAT=2              # bump when a snapshot's layout changes; eviction removes older ones
TEMPLATE_FORMAT=2              # likewise for dependency sets
PIDS=4096
CHOME=/home/sandbox            # HOME inside the containers (tmpfs)
PORT_BASE=5600                 # away from Vite's default 5173
PORT_SPAN=300
TEMPLATES_KEEP=2               # unused dependency sets kept, for switching between branches
NPM_CACHE_MAX_MB=1024          # the npm download cache is emptied above this

HOST_UID=$(id -u)
HOST_GID=$(id -g)

die() { printf 'dev-sandbox: %s\n' "$1" >&2; exit 1; }
note() { printf '[sandbox] %s\n' "$*" >&2; }

# What to undo if the script stops early, for whatever reason.
WORKTREE_PARTIAL=""   # a working-tree archive being written
TREE_PARTIAL=""       # a snapshot tree being extracted
TEMPLATE_PARTIAL=""   # a dependency set being installed
SNAP_PARTIAL=""       # a snapshot whose preparation ran the tree's code and has not finished
HOLD=""               # marks the snapshot this run uses, so another run's eviction leaves it
STEP_NAME=""          # the container `step` is waiting for
LOCK_HELD=0
SELFTEST_ACTIVE=0

# shellcheck disable=SC2329 # run by the EXIT trap
cleanup() {
  [ "$SELFTEST_ACTIVE" = 0 ] || selftest_teardown
  [ -z "$WORKTREE_PARTIAL" ] || rm -rf "$WORKTREE_PARTIAL"
  [ -z "$TREE_PARTIAL" ] || remove_tree "$TREE_PARTIAL"
  [ -z "$TEMPLATE_PARTIAL" ] || remove_tree "$TEMPLATE_PARTIAL"
  if [ -n "$SNAP_PARTIAL" ] && [ ! -f "$SNAP_PARTIAL/prepared" ]; then
    remove_tree "$SNAP_PARTIAL"
    note "removed the snapshot whose preparation did not finish"
  fi
  [ -z "$HOLD" ] || rm -f "$HOLD"
  [ "$LOCK_HELD" = 0 ] || rm -rf "$STATE/.lock.d"
}

# shellcheck disable=SC2329 # run by the signal traps
on_signal() {
  trap - INT TERM HUP
  [ -z "$STEP_NAME" ] || docker rm -f "$STEP_NAME" >/dev/null 2>&1 || true
  note "interrupted"
  exit 130
}
trap cleanup EXIT
trap on_signal INT TERM HUP

# `docker run --rm --name NAME ARGS...` in the background, waited for, so that an interrupt reaches
# on_signal at once (bash runs traps only between foreground commands) and removes the container.
step() {
  local name=$1 pid rc=0
  shift
  STEP_NAME=$name
  docker run --rm --name "$name" "$@" &
  pid=$!
  wait "$pid" || rc=$?
  STEP_NAME=""
  return "$rc"
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -c1-64
}

# Snapshot contents are written by sandboxed code, which may have removed its own write
# permission. chmod -R does not follow symbolic links met during the walk, and rm -rf never does.
remove_tree() {
  [ -e "$1" ] || [ -L "$1" ] || return 0
  chmod -R u+rwX "$1" 2>/dev/null || true
  rm -rf "$1"
}

# KiB under $1, ignoring files sandboxed code made unreadable.
size_kb() { { du -sk "$1" 2>/dev/null || true; } | awk '{ s += $1 } END { print s + 0 }'; }

human_kb() { awk -v k="$1" 'BEGIN { if (k >= 1048576) printf "%.1f GB", k / 1048576; else printf "%d MB", k / 1024 }'; }

ro() { printf 'type=bind,src=%s,dst=%s,readonly' "$1" "$2"; }
rw() { printf 'type=bind,src=%s,dst=%s' "$1" "$2"; }

usage() {
  cat <<'EOF'
Usage: ./dev-sandbox [TARGET] [--no-open]   start (or reuse) TARGET's dev server, print its URL and
                                            open it in a separate browser profile
       ./dev-sandbox --stop [TARGET | --all] stop dev servers (also: stop)
       ./dev-sandbox --status               dev servers, snapshots, disk use and limits (also: status)
       ./dev-sandbox test  [TARGET] [-- ARGS]     npm test [-- ARGS]
       ./dev-sandbox build [TARGET] [-- ARGS]     npm run build [-- ARGS]; prints where dist/ is
       ./dev-sandbox shell [TARGET] [-- CMD...]   interactive shell (or CMD), no network
       ./dev-sandbox seed  [TARGET] [--test-cache]  download the game data TARGET pins
       ./dev-sandbox selftest                     run the isolation self-test again
       ./dev-sandbox clean [TARGET | --all]       remove all snapshots and dependency sets; with
                                                  TARGET only its snapshot; with --all also seeds,
                                                  caches, browser profile, images and refs/sandbox/
       ./dev-sandbox dev [TARGET] [--no-open]     the dev server, for a TARGET named like a command

TARGET (default: HEAD of the checkout you are in)
  COMMIT-ISH   any commit in this repository; committed content only. Run someone else's branch
               this way, from a clean checkout of main.
  --pr N       pull request N, fetched over HTTPS without credentials from
               https://github.com/scimgg/scimgg.git (or SCIMGG_SANDBOX_UPSTREAM) into refs/sandbox/pr-N
  --worktree   your checkout's HEAD plus its uncommitted edits, deletions and untracked, non-ignored
               files; refuses symbolic links, leaves out nested repositories. For your own changes.

Requirements: bash 3.2+, git 2.31+, curl, Docker Engine 25.0+ on Linux or WSL2 (Docker Engine or
  Docker Desktop) or macOS (Docker Desktop, OrbStack or Colima). Not native Windows, Podman, or
  rootless or user-namespace-remapped Docker. Without a working Docker it says what to install or
  start, and exits 1.
Self-test: before the first run on a Docker daemon, and when its ID or version changes, probes
  check that the sandbox's containers reach nothing (DNS, internet, gateways, host addresses) and
  that the relay works. If a check fails, nothing runs; there is no weaker mode.
Seeds: the game cache, item icons and healthbars come from ~/.cache/scimgg-sandbox/seed, read-only.
  A command that needs a missing one names it; `./dev-sandbox seed TARGET` fetches what TARGET
  pins, checking each file against its pin, without running any of the tree's code.
Disk: under ~/.cache/scimgg-sandbox. Commands that prepare a snapshot first remove snapshots unused
  for SCIMGG_SANDBOX_KEEP_DAYS (7), a working tree's superseded snapshots, the least recently used
  while snapshots and dependency sets exceed SCIMGG_SANDBOX_MAX_GB (5), and what nothing uses.
Environment: SCIMGG_SANDBOX_CPUS, SCIMGG_SANDBOX_MEMORY (e.g. 6, 8g; default: Docker's CPUs less
  headroom, 3/4 of its memory up to 24g), SCIMGG_SANDBOX_KEEP_DAYS, SCIMGG_SANDBOX_MAX_GB,
  SCIMGG_SANDBOX_UPSTREAM.
More: docs/sandbox.md
EOF
}

# =============================================================================================
# Host checks

detect_platform() {
  case "$(uname -s)" in
    Linux)
      PLATFORM=linux
      if [ -r /proc/sys/kernel/osrelease ] && grep -qi microsoft /proc/sys/kernel/osrelease; then PLATFORM=wsl; fi
      ;;
    Darwin) PLATFORM=mac ;;
    MINGW* | MSYS* | CYGWIN*)
      die "native Windows is not supported. Install WSL2 (https://learn.microsoft.com/windows/wsl/install), clone the repository inside it and run ./dev-sandbox there."
      ;;
    *) die "unsupported system '$(uname -s)': ./dev-sandbox runs on Linux, WSL2 and macOS" ;;
  esac
}

docker_install_hint() {
  case "$PLATFORM" in
    mac) echo "Install Docker Desktop (https://docs.docker.com/desktop/setup/install/mac-install/), OrbStack (https://orbstack.dev) or Colima ('brew install colima docker')." ;;
    wsl) echo "Install Docker Engine inside WSL (https://docs.docker.com/engine/install/) or Docker Desktop with WSL integration (https://docs.docker.com/desktop/features/wsl/)." ;;
    *) echo "Install Docker Engine (https://docs.docker.com/engine/install/)." ;;
  esac
}

docker_start_hint() {
  case "$PLATFORM" in
    mac) echo "Start Docker Desktop or OrbStack, or run 'colima start', then try again." ;;
    *) echo "Start it ('sudo systemctl start docker' for Docker Engine, or open Docker Desktop), then try again." ;;
  esac
}

# Whether version $1 is at least $2.$3.
version_at_least() {
  local major=${1%%.*} minor=${1#*.}
  minor=${minor%%.*}
  case "$major.$minor" in *[!0-9.]* | .* | *.) return 2 ;; esac
  [ "$major" -gt "$2" ] || { [ "$major" -eq "$2" ] && [ "$minor" -ge "$3" ]; }
}

# git 2.31 for `rev-parse --path-format` and `ls-files --deduplicate`; curl for the dev server checks.
preflight_host() {
  local v rc=0
  command -v git >/dev/null 2>&1 || die "git is required and not on PATH"
  command -v curl >/dev/null 2>&1 || die "curl is required and not on PATH"
  v=$(git --version | awk '{print $3}')
  version_at_least "$v" 2 31 || rc=$?
  [ "$rc" -ne 2 ] || die "cannot read the git version '$v'"
  [ "$rc" -eq 0 ] || die "git $v is too old: ./dev-sandbox needs 2.31 or later"
}

# Stops with what to do unless a supported Docker engine answers. Sets DOCKER_VERSION, DOCKER_ID,
# DOCKER_OS, CPUS and MEMORY.
preflight_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is required, and 'docker' is not on PATH. $(docker_install_hint)"
  local client out info ncpu memtotal security mib rc=0 podman
  podman="Podman is not supported: the sandbox's isolation is only verified on Docker. $(docker_install_hint)"
  client=$(docker --version 2>/dev/null || true)
  case "$client" in *[Pp]odman*) die "'docker' here is Podman ($client). $podman" ;; esac
  if ! out=$(docker version --format '{{.Server.Version}}|{{range .Server.Components}}{{.Name}};{{end}}' 2>&1); then
    case "$out" in
      *"ermission denied"*)
        die "Docker is installed, but your user may not use its socket (permission denied). Add yourself to the docker group ('sudo usermod -aG docker \$USER', then log out and back in) or use Docker Desktop. Docker said: $(printf '%s\n' "$out" | tail -n 1)"
        ;;
      *) die "the Docker daemon is not reachable${DOCKER_HOST:+ at DOCKER_HOST=$DOCKER_HOST}. $(docker_start_hint) Docker said: $(printf '%s\n' "$out" | tail -n 1)" ;;
    esac
  fi
  case "$out" in *[Pp]odman*) die "the Docker API here is served by Podman. $podman" ;; esac
  DOCKER_VERSION=${out%%|*}
  version_at_least "$DOCKER_VERSION" "$MIN_DOCKER_MAJOR" "$MIN_DOCKER_MINOR" || rc=$?
  [ "$rc" -ne 2 ] || die "cannot read the Docker engine version '$DOCKER_VERSION'"
  [ "$rc" -eq 0 ] || die "Docker Engine $DOCKER_VERSION is too old: ./dev-sandbox needs $MIN_DOCKER_MAJOR.$MIN_DOCKER_MINOR or later, for internal networks that give the host no address (com.docker.network.bridge.inhibit_ipv4). Update Docker and try again."

  info=$(docker info --format '{{.ID}}|{{.NCPU}}|{{.MemTotal}}|{{.OperatingSystem}}|{{.SecurityOptions}}' 2>&1) ||
    die "docker info failed: $info"
  DOCKER_ID=${info%%|*}; info=${info#*|}
  ncpu=${info%%|*}; info=${info#*|}
  memtotal=${info%%|*}; info=${info#*|}
  DOCKER_OS=${info%%|*}
  security=${info#*|}
  case "$security" in
    *rootless* | *userns*)
      die "rootless or user-namespace-remapped Docker is not supported: there the sandbox's non-root container user does not map to you, so it cannot use the snapshot it is given, and the fix (running as root inside the container) is a weaker contract. Use rootful Docker Engine or Docker Desktop."
      ;;
  esac

  if [ -n "${SCIMGG_SANDBOX_CPUS:-}" ]; then
    [[ $SCIMGG_SANDBOX_CPUS =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "SCIMGG_SANDBOX_CPUS must be a number of CPUs, such as 4 or 2.5"
    [ "${SCIMGG_SANDBOX_CPUS%%.*}" -lt "$ncpu" ] || [ "$SCIMGG_SANDBOX_CPUS" = "$ncpu" ] ||
      die "SCIMGG_SANDBOX_CPUS=$SCIMGG_SANDBOX_CPUS is more than the $ncpu CPUs Docker has"
    CPUS=$SCIMGG_SANDBOX_CPUS
  elif [ "$ncpu" -ge 4 ]; then
    CPUS=$((ncpu - 2))
  elif [ "$ncpu" -ge 2 ]; then
    CPUS=$((ncpu - 1))
  else
    CPUS=1
  fi
  if [ -n "${SCIMGG_SANDBOX_MEMORY:-}" ]; then
    [[ $SCIMGG_SANDBOX_MEMORY =~ ^[1-9][0-9]*[mMgG]$ ]] || die "SCIMGG_SANDBOX_MEMORY must be like 8g or 6144m"
    MEMORY=$SCIMGG_SANDBOX_MEMORY
  else
    mib=$((memtotal * 3 / 4 / 1048576))
    [ "$mib" -le 24576 ] || mib=24576
    MEMORY="${mib}m"
    [ "$mib" -ge 6144 ] || note "Docker has $((memtotal / 1048576)) MiB of memory, so containers get ${mib} MiB; the full test suite may need more (give Docker more memory, or set SCIMGG_SANDBOX_MEMORY)"
  fi
}

read_limits() {
  KEEP_DAYS=${SCIMGG_SANDBOX_KEEP_DAYS:-7}
  MAX_GB=${SCIMGG_SANDBOX_MAX_GB:-5}
  [[ $KEEP_DAYS =~ ^[0-9]+$ ]] || die "SCIMGG_SANDBOX_KEEP_DAYS must be a whole number of days, such as 7"
  [[ $MAX_GB =~ ^[0-9]+$ ]] || die "SCIMGG_SANDBOX_MAX_GB must be a whole number of GB, such as 5"
}

# A passwd and group that know your uid and gid, so tools that look the user up work for any uid
# (macOS users are 501; the image only knows 1000).
ensure_identity() {
  mkdir -p "$STATE/etc"
  printf 'root:x:0:0:root:/root:/usr/sbin/nologin\nsandbox:x:%s:%s:sandbox:%s:/bin/bash\nnobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin\n' \
    "$HOST_UID" "$HOST_GID" "$CHOME" > "$STATE/etc/passwd"
  printf 'root:x:0:\nsandbox:x:%s:\nnogroup:x:65534:\n' "$HOST_GID" > "$STATE/etc/group"
}

# One run prepares or evicts at a time. mkdir is atomic everywhere (flock is not on macOS); a lock
# whose owner has gone is taken over.
acquire_lock() {
  local lock="$STATE/.lock.d" pid waited=0
  mkdir -p "$STATE"
  until mkdir "$lock" 2>/dev/null; do
    pid=$(cat "$lock/pid" 2>/dev/null || true)
    if { [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; } || { [ -z "$pid" ] && [ "$waited" -ge 10 ]; }; then
      note "taking over a lock left by a run that is gone (${pid:-no pid})"
      rm -rf "$lock"
      continue
    fi
    [ "$waited" -ne 0 ] || note "waiting for another ./dev-sandbox run (process ${pid:-?}) to finish preparing"
    sleep 1
    waited=$((waited + 1))
  done
  echo "$$" > "$lock/pid"
  LOCK_HELD=1
}

release_lock() {
  rm -rf "$STATE/.lock.d"
  LOCK_HELD=0
}

# Pulls an image by digest unless Docker has it, and records that this script pulled it, so that
# eviction may later remove that reference, and only that one, once nothing pins it.
ensure_pulled() {
  docker image inspect "$1" >/dev/null 2>&1 && return 0
  note "pulling $1 (once)"
  docker pull --quiet "$1" >/dev/null || die "could not pull $1"
  mkdir -p "$STATE"
  echo "$1" >> "$STATE/pulled-images"
}

# =============================================================================================
# Targets and snapshots

REPO=""            # git repository the commit is archived from
SHA=""             # full commit SHA (for a working tree, its HEAD)
ID=""              # the snapshot's key: SHA, or for a working tree SHA-worktree-<content hash>
WORKTREE_TAR=""    # for a working tree: its archive, the only source the host reads its files from
SOURCE=""          # human description

current_repo() {
  git rev-parse --show-toplevel 2>/dev/null || git -C "$SANDBOX_ROOT" rev-parse --show-toplevel
}

# Fetches pull request N into refs/sandbox/pr-N; with `local`, uses the ref already there, to stop
# or clean what an earlier run started even if the pull request has moved since.
fetch_pr() {
  local n=$1 mode=${2:-fetch}
  [[ $n =~ ^[1-9][0-9]*$ ]] || die "--pr needs a pull request number, not '$n'"
  REPO=$(current_repo)
  SOURCE="pull request #$n"
  if [ "$mode" = local ]; then
    SHA=$(git -C "$REPO" rev-parse --verify --quiet "refs/sandbox/pr-$n^{commit}") || die "pull request $n was never fetched here"
    return
  fi
  case "$UPSTREAM_URL" in https://*) ;; *) die "SCIMGG_SANDBOX_UPSTREAM must be an https:// URL" ;; esac
  note "fetching pull request $n from $UPSTREAM_URL (read-only, no credentials)"
  # No credential helper, prompt or extra header, and https only, so a URL rewrite in your git
  # config cannot turn this into an SSH fetch with your keys.
  GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false \
    git -C "$REPO" -c credential.helper= -c credential.https://github.com.helper= \
      -c http.extraHeader= -c http.https://github.com/.extraHeader= -c core.askPass=/bin/false \
      -c protocol.allow=never -c protocol.https.allow=always -c fetch.fsckObjects=true \
      fetch --quiet --no-tags --no-write-fetch-head "$UPSTREAM_URL" "+pull/$n/head:refs/sandbox/pr-$n" ||
    die "could not fetch pull request $n from $UPSTREAM_URL"
  SHA=$(git -C "$REPO" rev-parse --verify "refs/sandbox/pr-$n^{commit}")
}

# The working tree as one deterministic tar, built by the archive helper in a no-network container
# (the same GNU tools on every host) from the paths git lists here.
archive_worktree() {
  local dir=$1 out=$2 rc=0
  git -C "$dir" ls-files -z --deleted > "$out/deleted"
  git -C "$dir" ls-files -z --cached --others --exclude-standard --deduplicate > "$out/all"
  base_flags none
  step "scimgg-sandbox-archive-$$" "${FLAGS[@]}" --mount "$(ro "$TOOLS" /sandbox-tools)" \
    --mount "$(ro "$dir" /src)" --mount "$(ro "$out" /req)" --mount "$(rw "$out" /out)" \
    "$TOOLS_IMAGE" bash /sandbox-tools/archive-worktree.sh || rc=$?
  [ "$rc" -eq 0 ] || die "could not snapshot $dir (see above); nothing was run"
}

resolve_target() {
  local kind=$1 spec=$2 mode=${3:-fetch}
  KIND=$kind
  case "$kind" in
    pr) fetch_pr "$spec" "$mode" ;;
    worktree)
      REPO=$(current_repo)
      SHA=$(git -C "$REPO" rev-parse --verify 'HEAD^{commit}')
      SOURCE="$REPO working tree"
      # Stopping or cleaning works on whatever this tree started, so it needs no new archive.
      [ "$mode" = local ] && return 0
      mkdir -p "$STATE/tmp"
      local work hash
      work=$(mktemp -d "$STATE/tmp/worktree.XXXXXX")
      WORKTREE_PARTIAL=$work
      archive_worktree "$REPO" "$work"
      WORKTREE_TAR="$work/worktree.tar"
      hash=$(sha256 < "$WORKTREE_TAR" | cut -c1-16)
      ID="$SHA-worktree-$hash"
      SHORT="${SHA:0:7}-w$hash"
      SHORT=${SHORT:0:16}
      note "$SOURCE: HEAD $SHA plus these changes (content $hash):"
      GIT_OPTIONAL_LOCKS=0 git -C "$REPO" status --short --untracked-files=all | sed 's/^/    /' >&2
      ;;
    commit)
      REPO=$(current_repo)
      SHA=$(git -C "$REPO" rev-parse --verify --quiet "$spec^{commit}") || die "no commit '$spec' in $REPO"
      SOURCE="$spec"
      if [ "$spec" = HEAD ] && [ -n "$(git -C "$REPO" status --porcelain --untracked-files=no)" ]; then
        note "the working tree has uncommitted changes; they are not included (--worktree includes them)"
      fi
      ;;
  esac
  if [ -z "$WORKTREE_TAR" ]; then
    ID=$SHA
    SHORT=${SHA:0:12}
  fi
  SNAP="$STATE/snapshots/$ID"
  TREE="$SNAP/tree"
  APP="scimgg-sandbox-dev-$SHORT"
  PROXY="scimgg-sandbox-proxy-$SHORT"
  NET="scimgg-sandbox-net-$SHORT"
}

# A file of the target as git stores it (or as the working-tree archive holds it), never read
# through the extracted tree, which sandboxed code can change.
blob() {
  if [ -n "$WORKTREE_TAR" ]; then tar -xOf "$WORKTREE_TAR" "$1"; else git -C "$REPO" show "$SHA:$1"; fi
}

has_blob() {
  if [ -n "$WORKTREE_TAR" ]; then
    tar -tf "$WORKTREE_TAR" "$1" >/dev/null 2>&1
  else
    git -C "$REPO" cat-file -e "$SHA:$1" 2>/dev/null
  fi
}

regular_blob() {
  local mode
  if [ -n "$WORKTREE_TAR" ]; then
    # The working-tree archive holds regular files only.
    has_blob "$1" || die "$1 is missing from $SOURCE"
    return 0
  fi
  mode=$(git -C "$REPO" ls-tree "$SHA" -- "$1" | cut -d' ' -f1)
  [ "$mode" = 100644 ] || [ "$mode" = 100755 ] || die "$1 in $SHORT is missing or not a regular file"
}

# How to run this kind of tree. These are the defaults for this repository's trees; a fork's
# dev-sandbox.local may define sandbox_local_target to change any of them (docs/sandbox.md).
target_settings() {
  VARIETY=public                                 # a name for this kind of tree
  NODE_MAJOR=""                                  # default: the tree's .nvmrc
  SEED_CHECK=(node /sandbox-tools/seed.mjs check)  # no network, tree read-only; exit 3 = missing
  SEED_CHECK_ALWAYS=0                            # 1: check before dev and build of a prepared snapshot too
  PREPARE_SCRIPT='node /sandbox-tools/seed.mjs assets && npm run setup -- --offline'
  # shellcheck disable=SC2016 # expanded by the container's bash
  BUILD_SCRIPT='npm run build -- "$@"'
  SEED_FETCH=(node /sandbox-tools/seed.mjs fetch)  # `seed`: network, tree read-only
  RUN_FLAGS=()                                   # read-only mounts and -e for every tree container
  SEED_FLAGS=()                                  # mounts for the `seed` container
  if declare -F sandbox_local_target >/dev/null; then sandbox_local_target; fi
  return 0
}

make_snapshot() {
  if [ -d "$SNAP" ] && [ "$(cat "$SNAP/format" 2>/dev/null)" != "$SNAPSHOT_FORMAT" ]; then
    PROTECTED="|$(sandbox_snapshot_ids)"
    snap_protected "$ID" && die "containers of an older ./dev-sandbox still use $SNAP; stop them (./dev-sandbox stop --all) first"
    remove_tree "$SNAP"
  fi
  mkdir -p "$SNAP/vite"
  echo "$SNAPSHOT_FORMAT" > "$SNAP/format"
  touch "$SNAP/used"
  HOLD="$SNAP/hold.$$"
  : > "$HOLD"
  if [ -n "$WORKTREE_TAR" ] && [ "$WORKTREE_TAR" != "$SNAP/worktree.tar" ]; then
    [ -f "$SNAP/worktree.tar" ] || mv "$WORKTREE_TAR" "$SNAP/worktree.tar"
    WORKTREE_TAR="$SNAP/worktree.tar"
    rm -rf "$WORKTREE_PARTIAL"
    WORKTREE_PARTIAL=""
  fi
  printf '%s\n' "$SOURCE" > "$SNAP/source"
  [ -d "$TREE" ] && return 0
  local partial="$SNAP/tree.partial"
  TREE_PARTIAL=$partial
  remove_tree "$partial"
  mkdir "$partial"
  if [ -n "$WORKTREE_TAR" ]; then
    note "snapshot $ID ($SOURCE): working-tree archive"
    tar -x -C "$partial" -f "$WORKTREE_TAR"
    [ -z "$(find "$partial" ! -type f ! -type d -print)" ] || die "the working-tree archive held a non-regular file"
  else
    note "snapshot $SHA ($SOURCE): git archive"
    # No user attribute file and no LFS filter, so archiving runs nothing but git itself.
    git -C "$REPO" -c core.attributesFile=/dev/null -c filter.lfs.smudge= -c filter.lfs.process= \
      -c filter.lfs.required=false archive --format=tar "$SHA" | tar -x -C "$partial" -f -
  fi
  if [ -e "$partial/node_modules" ] || [ -L "$partial/node_modules" ]; then
    die "$SOURCE has its own node_modules; refusing it"
  fi
  # The mount point for the shared, read-only dependency set.
  mkdir "$partial/node_modules"
  mv "$partial" "$TREE"
  TREE_PARTIAL=""
}

# Stops before anything runs if the seeds lack what this command needs, and names the
# `./dev-sandbox seed` that fetches it. Only for a snapshot not yet prepared, unless SEED_CHECK_ALWAYS.
check_seeds() {
  if [ -f "$SNAP/prepared" ] && { [ "$SEED_CHECK_ALWAYS" = 0 ] || { [ "$CMD" != dev ] && [ "$CMD" != build ]; }; }; then
    return 0
  fi
  local rc=0
  run_flags
  base_flags none
  step "scimgg-sandbox-check-$SHORT" "${FLAGS[@]}" "${RUNF[@]}" --label "scimgg.sandbox.sha=$ID" \
    --mount "$(ro "$TREE" /work)" -w /work "$IMAGE" "${SEED_CHECK[@]}" "$CMD" || rc=$?
  [ "$rc" -ne 3 ] || die "the seed data above is missing. Fetch it with: ./dev-sandbox seed${TARGET_ARGS:+ $TARGET_ARGS}"
  [ "$rc" -eq 0 ] || die "checking the seed data failed"
}

prepare_snapshot() {
  printf '%s\n' "$TEMPLATE_KEY" > "$SNAP/template"
  [ -f "$SNAP/prepared" ] && return 0
  SNAP_PARTIAL=$SNAP
  note "preparing snapshot: seed data, then ${PREPARE_SCRIPT##*&& }"
  run_flags
  tree_flags
  base_flags none
  step "scimgg-sandbox-prepare-$SHORT" "${FLAGS[@]}" "${RUNF[@]}" "${TREEF[@]}" \
    "$IMAGE" bash -c "$PREPARE_SCRIPT" || die "preparing the snapshot failed"
  touch "$SNAP/prepared"
  SNAP_PARTIAL=""
  record_size
}

# =============================================================================================
# Install template: the image, and node_modules once per lockfile

pick_image() {
  local major=$NODE_MAJOR word pinned=""
  if [ -z "$major" ] && has_blob .nvmrc; then
    major=$(blob .nvmrc | tr -d '[:space:]v' | cut -d. -f1)
  fi
  [ -n "$major" ] || die "$SOURCE has no .nvmrc naming the Node version to run"
  BASE_IMAGE=""
  for word in $NODE_IMAGES; do
    pinned="$pinned ${word%%=*}"
    [ "${word%%=*}" != "$major" ] || BASE_IMAGE=${word#*=}
  done
  [ -n "$BASE_IMAGE" ] || die "$SOURCE asks for Node '$major'; ./dev-sandbox pins an image for Node$pinned only (NODE_IMAGES)"
  NODE_MAJOR=$major
  ensure_pulled "$BASE_IMAGE"
  # Tagged by what it is built from, so any change makes a new tag and eviction removes the old
  # one. Built from the Dockerfile alone, with an empty context; apt-get fetches from Debian's
  # mirrors, and no snapshot is involved.
  IMAGE=$(built_image_tag "$major" "$BASE_IMAGE")
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    note "building $IMAGE: $BASE_IMAGE plus $SANDBOX_APT_PACKAGES (once)"
    dockerfile | docker build --quiet --label scimgg.sandbox=1 --build-arg "NODE_IMAGE=$BASE_IMAGE" \
      --build-arg "PACKAGES=$SANDBOX_APT_PACKAGES" -t "$IMAGE" - >/dev/null || die "could not build $IMAGE"
  fi
}

dockerfile() {
  if [ -n "$SANDBOX_DOCKERFILE" ]; then cat "$SANDBOX_DOCKERFILE"; else dockerfile_text; fi
}

built_image_tag() {
  printf 'scimgg-sandbox-node:%s-%s' "$1" "$( { dockerfile; echo "$2"; echo "$SANDBOX_APT_PACKAGES"; } | sha256 | cut -c1-12)"
}

template_key() {
  regular_blob package.json
  regular_blob package-lock.json
  has_blob npm-shrinkwrap.json && die "$SHORT has an npm-shrinkwrap.json; refusing to install it"
  TEMPLATE_KEY=$(printf '%s %s %s %s\n' "$(blob package.json | sha256)" "$(blob package-lock.json | sha256)" \
    "$IMAGE" "$TEMPLATE_FORMAT" | sha256 | cut -c1-16)
  TEMPLATE="$STATE/node-modules/$TEMPLATE_KEY"
}

# node_modules is installed once per (package.json, package-lock.json, image) in a directory that
# holds only those two files, so no other code of the tree is there while the network is up or
# dependency scripts run. Snapshots then mount it read-only. It is built under a temporary name and
# renamed when complete, so an interrupted install leaves nothing a later run would use.
ensure_template() {
  if [ -d "$TEMPLATE/node_modules" ] && [ -f "$TEMPLATE/format" ]; then
    touch "$TEMPLATE/used"
    return 0
  fi
  local work="$TEMPLATE.partial.$$" key=$TEMPLATE_KEY
  TEMPLATE_PARTIAL=$work
  remove_tree "$work"
  mkdir -p "$work/build" "$STATE/npm-cache"
  blob package.json > "$work/build/package.json"
  blob package-lock.json > "$work/build/package-lock.json"

  # The checker comes from the checkout this script lives in, not from the tree under test, which
  # could have changed it to pass anything.
  [ -f "$SANDBOX_ROOT/scripts/check-lockfile.mjs" ] || die "missing $SANDBOX_ROOT/scripts/check-lockfile.mjs"
  note "lockfile check (trusted checker, no network)"
  base_flags none
  step "scimgg-sandbox-lockcheck-$key" "${FLAGS[@]}" \
    --mount "$(ro "$work/build" /build)" \
    --mount "$(ro "$SANDBOX_ROOT/scripts/check-lockfile.mjs" /trusted/check-lockfile.mjs)" \
    --mount "$(ro "$SANDBOX_ROOT/scripts/lockfileSources.mjs" /trusted/lockfileSources.mjs)" \
    "$IMAGE" node /trusted/check-lockfile.mjs /build || die "lockfile check failed; not installing"

  note "npm ci --ignore-scripts (the only step with network)"
  base_flags bridge
  step "scimgg-sandbox-install-$key" "${FLAGS[@]}" \
    --mount "$(rw "$work/build" /build)" --mount "$(rw "$STATE/npm-cache" /npm-cache)" \
    -e npm_config_cache=/npm-cache -w /build \
    "$IMAGE" npm ci --ignore-scripts --no-audit --no-fund || die "npm ci failed"

  note "npm rebuild: dependency install scripts, no network"
  base_flags none
  # Prebuilt-binary downloads fail with no network, so native modules build from source against
  # the image's own Node headers.
  step "scimgg-sandbox-rebuild-$key" "${FLAGS[@]}" \
    --mount "$(rw "$work/build" /build)" -e npm_config_nodedir=/usr/local -w /build \
    "$IMAGE" npm rebuild --foreground-scripts || die "npm rebuild failed"

  # Mount points for the caches that stay writable (tree_flags).
  mkdir -p "$work/build/node_modules/.vite" "$work/build/node_modules/.vite-temp" "$work/build/node_modules/.cache"
  mv "$work/build/node_modules" "$work/node_modules"
  rm -rf "$work/build"
  echo "$IMAGE" > "$work/image"
  echo "$TEMPLATE_FORMAT" > "$work/format"
  size_kb "$work" > "$work/size"
  touch "$work/used"
  remove_tree "$TEMPLATE"
  mv "$work" "$TEMPLATE"
  TEMPLATE_PARTIAL=""

  # Every package is checked against its integrity hash, so refetching is safe.
  if [ "$(size_kb "$STATE/npm-cache")" -gt $((NPM_CACHE_MAX_MB * 1024)) ]; then
    remove_tree "$STATE/npm-cache"
    note "emptied the npm download cache (over $NPM_CACHE_MAX_MB MB)"
  fi
}

# =============================================================================================
# Containers

# Flags every sandbox container shares. Nothing from the host environment is passed: only the
# variables listed here and in each caller.
base_flags() {
  local net=$1
  FLAGS=(
    --init
    --network "$net"
    --user "$HOST_UID:$HOST_GID"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --read-only
    --tmpfs "/tmp:rw,nosuid,nodev,exec,size=4g"
    --tmpfs "$CHOME:rw,nosuid,nodev,noexec,size=512m,uid=$HOST_UID,gid=$HOST_GID,mode=0700"
    --tmpfs "$CHOME/.cache:rw,nosuid,nodev,noexec,size=512m,uid=$HOST_UID,gid=$HOST_GID,mode=0700"
    --mount "type=bind,src=$STATE/etc/passwd,dst=/etc/passwd,readonly"
    --mount "type=bind,src=$STATE/etc/group,dst=/etc/group,readonly"
    --pids-limit "$PIDS"
    --memory "$MEMORY" --memory-swap "$MEMORY"
    --cpus "$CPUS"
    --hostname scimgg-sandbox
    --label scimgg.sandbox=1
    -e HOME="$CHOME"
    -e npm_config_update_notifier=false
    -e npm_config_fund=false
    -e npm_config_audit=false
    -e PUPPETEER_SKIP_DOWNLOAD=1
  )
  if [ "$net" = none ]; then
    FLAGS+=(-e npm_config_offline=true -e npm_config_cache=/tmp/npm-cache)
  fi
}

# The embedded helpers, written once per content to a directory named by their hash and mounted
# read-only at /sandbox-tools. An existing directory is used only if its files still hash to its
# name. Sets TOOLS.
ensure_tools() {
  local hash work
  hash=$(tools_digest_of_text)
  TOOLS="$STATE/tools/$hash"
  if [ -d "$TOOLS" ] && [ "$(tools_digest_of_dir "$TOOLS")" = "$hash" ]; then return 0; fi
  mkdir -p "$STATE/tools"
  work=$(mktemp -d "$STATE/tools/partial.XXXXXX")
  probe_mjs > "$work/probe.mjs"
  proxy_mjs > "$work/proxy.mjs"
  seed_mjs > "$work/seed.mjs"
  archive_worktree_sh > "$work/archive-worktree.sh"
  chmod 0444 "$work"/*
  chmod 0555 "$work"
  remove_tree "$TOOLS"
  mv "$work" "$TOOLS"
}

tools_digest_of_text() { { probe_mjs; proxy_mjs; seed_mjs; archive_worktree_sh; } | sha256 | cut -c1-16; }

tools_digest_of_dir() {
  cat "$1/probe.mjs" "$1/proxy.mjs" "$1/seed.mjs" "$1/archive-worktree.sh" 2>/dev/null | sha256 | cut -c1-16
}

main_checkout() {
  cd "$(git -C "$SANDBOX_ROOT" rev-parse --path-format=absolute --git-common-dir)/.." && pwd -P
}

# The golden real-cache test fixture: a checkout's .test-cache/ (where the tests look by default),
# or the one `./dev-sandbox seed --test-cache` saved.
test_cache_dir() {
  local dir
  for dir in "$(current_repo)" "$(main_checkout)"; do
    if [ -f "$dir/.test-cache/disk.zip" ]; then echo "$dir/.test-cache"; return 0; fi
  done
  if [ -f "$STATE/seed/test-cache/disk.zip" ]; then echo "$STATE/seed/test-cache"; fi
}

# Read-only seed data and helpers for every container that checks or runs the snapshot.
TEST_NOTE_SHOWN=0
run_flags() {
  local test_cache
  mkdir -p "$STATE/seed"
  RUNF=(--mount "$(ro "$STATE/seed" /seed)" --mount "$(ro "$TOOLS" /sandbox-tools)")
  test_cache=$(test_cache_dir)
  if [ -n "$test_cache" ]; then
    RUNF+=(--mount "$(ro "$test_cache" /seed-test-cache)" -e SCIM_REAL_CACHE_PATH=/seed-test-cache/disk.zip)
  elif [ "$CMD" = test ] && [ "$TEST_NOTE_SHOWN" = 0 ]; then
    note "no golden test cache (.test-cache/disk.zip): the real-cache suites skip. ./dev-sandbox seed ${TARGET_ARGS:+$TARGET_ARGS }--test-cache fetches it (160 MB)."
    TEST_NOTE_SHOWN=1
  fi
  RUNF+=(${RUN_FLAGS[@]+"${RUN_FLAGS[@]}"})
}

# The snapshot at /work, with the shared dependency set read-only at /work/node_modules. Only
# Vite's caches in it are writable: .vite (pre-bundled dependencies and Vitest's results) per
# snapshot, .vite-temp (the bundled config) and .cache in memory.
tree_flags() {
  [ -d "$TREE/node_modules" ] && [ ! -L "$TREE/node_modules" ] ||
    die "$TREE/node_modules is not the directory this script made; ./dev-sandbox clean ${TARGET_ARGS:-HEAD} resets the snapshot"
  TREEF=(
    --mount "$(rw "$TREE" /work)"
    --mount "$(ro "$TEMPLATE/node_modules" /work/node_modules)"
    --mount "$(rw "$SNAP/vite" /work/node_modules/.vite)"
    --tmpfs "/work/node_modules/.vite-temp:rw,nosuid,nodev,size=256m,uid=$HOST_UID,gid=$HOST_GID"
    --tmpfs "/work/node_modules/.cache:rw,nosuid,nodev,size=1g,uid=$HOST_UID,gid=$HOST_GID"
    --label "scimgg.sandbox.sha=$ID"
    -w /work
  )
}

tty_flags() {
  TTY=()
  if [ -t 0 ] && [ -t 1 ]; then TTY=(-it -e TERM=xterm-256color); fi
}

# A one-off command in the snapshot, with no network. Returns its status.
run_in_snapshot() {
  local role=$1 rc=0
  shift
  run_flags
  tree_flags
  base_flags none
  tty_flags
  docker run --rm "${FLAGS[@]}" "${RUNF[@]}" "${TREEF[@]}" ${TTY[@]+"${TTY[@]}"} \
    --name "scimgg-sandbox-$role-$SHORT" "$IMAGE" "$@" || rc=$?
  record_size
  return "$rc"
}

# =============================================================================================
# Dev server and relay

running() { [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = true ]; }

# Starts relay container NAME (default bridge, publishing 127.0.0.1:PORT) that forwards to TARGET on
# NET, trying ports from START upwards: Docker refuses a port that is taken, which finds a free one
# on any host without ss or lsof. Further arguments are extra labels. Sets RELAY_PORT.
start_relay() {
  local name=$1 target=$2 net=$3 start=$4 port=$4 tries=0 out
  shift 4
  while :; do
    docker rm -f "$name" >/dev/null 2>&1 || true
    base_flags bridge
    docker create "${FLAGS[@]}" "$@" --label scimgg.sandbox.role=proxy --label "scimgg.sandbox.port=$port" \
      --name "$name" --memory 128m --memory-swap 128m --pids-limit 64 \
      -p "127.0.0.1:$port:$port" -e SANDBOX_PORT="$port" -e SANDBOX_TARGET="$target" \
      --mount "$(ro "$TOOLS" /sandbox-tools)" "$TOOLS_IMAGE" node /sandbox-tools/proxy.mjs >/dev/null
    docker network connect "$net" "$name"
    if out=$(docker start "$name" 2>&1); then
      RELAY_PORT=$port
      return 0
    fi
    case "$out" in
      *"already in use"* | *"already allocated"* | *"not available"* | *"bind:"*) ;;
      *) docker rm -f "$name" >/dev/null 2>&1 || true; die "could not start the relay: $out" ;;
    esac
    tries=$((tries + 1))
    [ "$tries" -lt 30 ] || { docker rm -f "$name" >/dev/null 2>&1 || true; die "no free port in $PORT_BASE-$((PORT_BASE + PORT_SPAN - 1)) near $start"; }
    port=$((PORT_BASE + (port - PORT_BASE + 1) % PORT_SPAN))
  done
}

# Removes one dev sandbox by its short name. Returns 1 if there was none.
stop_short() {
  local short=$1 removed=1 name
  # `docker rm -f` succeeds for a missing container, so look first.
  for name in "scimgg-sandbox-dev-$short" "scimgg-sandbox-proxy-$short"; do
    if docker container inspect "$name" >/dev/null 2>&1; then docker rm -f "$name" >/dev/null; removed=0; fi
  done
  if docker network inspect "scimgg-sandbox-net-$short" >/dev/null 2>&1; then
    docker network rm "scimgg-sandbox-net-$short" >/dev/null
    removed=0
  fi
  return $removed
}

# Short names of the dev sandboxes started from this target's working tree, except `keep`.
worktree_sandboxes() {
  local keep=${1:-} short source
  docker ps -a --filter label=scimgg.sandbox.role=dev \
    --format '{{.Label "scimgg.sandbox.short"}}|{{.Label "scimgg.sandbox.source"}}' |
    while IFS='|' read -r short source; do
      if [ "$source" = "$SOURCE" ] && [ "$short" != "$keep" ]; then echo "$short"; fi
    done
  return 0
}

stop_target() {
  local short found=0
  if [ "$KIND" = worktree ]; then
    # The tree may have changed since its sandbox started, so match the tree, not its content.
    for short in $(worktree_sandboxes); do
      if stop_short "$short"; then echo "Stopped sandbox $short"; found=1; fi
    done
    [ "$found" = 1 ] || echo "No sandbox running for $SOURCE"
    return 0
  fi
  if stop_short "$SHORT"; then echo "Stopped sandbox $SHORT"; else echo "No sandbox running for $SHORT"; fi
}

server_ready() { curl --connect-timeout 1 --max-time 3 -fsS "http://localhost:$1/" >/dev/null 2>&1; }

# Only ever a separate profile, never the default browser or profile.
open_browser() {
  local url=$1 profile="$STATE/browser-profile" app dir bin appdata
  local chrome_exe="/mnt/c/Program Files/Google/Chrome/Application/chrome.exe"
  case "$PLATFORM" in
    wsl)
      if [ -f "$chrome_exe" ] && command -v cmd.exe >/dev/null 2>&1; then
        appdata=$( (cd /mnt/c && cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null) | tr -d '\r')
        if [[ $appdata =~ ^[A-Za-z]:\\ ]]; then
          "$chrome_exe" --user-data-dir="$appdata\\scimgg-sandbox-chrome" --no-first-run --no-default-browser-check \
            "$url" >/dev/null 2>&1 &
          return 0
        fi
      fi
      ;;
    mac)
      for app in "Google Chrome" "Chromium" "Microsoft Edge" "Brave Browser"; do
        for dir in /Applications "$HOME/Applications"; do
          if [ -d "$dir/$app.app" ]; then
            open -na "$dir/$app.app" --args --user-data-dir="$profile" --no-first-run --no-default-browser-check "$url"
            return 0
          fi
        done
      done
      ;;
  esac
  if [ "$PLATFORM" != mac ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    for bin in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge brave-browser; do
      if command -v "$bin" >/dev/null 2>&1; then
        nohup "$bin" --user-data-dir="$profile" --no-first-run --no-default-browser-check "$url" >/dev/null 2>&1 &
        return 0
      fi
    done
  fi
  echo "Open $url in a separate browser profile, not your everyday one: its page runs code you did not write."
}

start_dev() {
  if running "$APP" && running "$PROXY"; then
    RELAY_PORT=$(docker inspect -f '{{index .Config.Labels "scimgg.sandbox.port"}}' "$PROXY")
    note "reusing the running sandbox"
  else
    stop_short "$SHORT" || true
    if [ "$KIND" = worktree ]; then
      # Like `npm run dev`, one server per working tree: an edit replaces the old content's server.
      local old
      for old in $(worktree_sandboxes "$SHORT"); do
        if stop_short "$old"; then note "stopped $old, started from earlier content of this tree"; fi
      done
    fi
    local labels=(--label "scimgg.sandbox.sha=$ID" --label "scimgg.sandbox.short=$SHORT"
      --label "scimgg.sandbox.source=$SOURCE")
    # --internal alone still gives the host an address on the bridge, through which the app could
    # reach every host service listening on 0.0.0.0. inhibit_ipv4 leaves the host none.
    docker network create --internal -o com.docker.network.bridge.inhibit_ipv4=true \
      --label scimgg.sandbox=1 "$NET" >/dev/null
    # The relay first: the port it gets is the one Vite must serve on, for HMR.
    start_relay "$PROXY" "$APP" "$NET" $((PORT_BASE + $(printf '%s' "$ID" | cksum | cut -d' ' -f1) % PORT_SPAN)) "${labels[@]}"

    run_flags
    tree_flags
    base_flags "$NET"
    # SCIM_DEV_LAN=1 makes Vite bind every interface of this container, whose only network is the
    # internal one; the host side is the relay's 127.0.0.1 binding.
    docker run -d "${FLAGS[@]}" "${RUNF[@]}" "${TREEF[@]}" "${labels[@]}" --label scimgg.sandbox.role=dev \
      --label "scimgg.sandbox.port=$RELAY_PORT" --name "$APP" -e SCIM_DEV_LAN=1 \
      "$IMAGE" npx vite --host 0.0.0.0 --port "$RELAY_PORT" --strictPort >/dev/null

    local attempts=0
    until server_ready "$RELAY_PORT"; do
      if ! running "$APP"; then
        docker logs --tail 40 "$APP" >&2 || true
        stop_target >/dev/null
        die "the dev server exited; see the log above"
      fi
      attempts=$((attempts + 1))
      [ $attempts -lt 240 ] || die "timed out waiting for the dev server; docker logs $APP"
      sleep 0.5
    done
  fi

  local url="http://localhost:$RELAY_PORT"
  echo ""
  echo "  Commit:  $SHA${WORKTREE_TAR:+ plus working-tree changes (snapshot $ID)}"
  echo "  Source:  $SOURCE"
  echo "  URL:     $url"
  echo "  Log:     docker logs -f $APP"
  echo "  Stop:    ./dev-sandbox --stop${TARGET_ARGS:+ $TARGET_ARGS}"
  echo "  Access:  127.0.0.1 only; the app container has no network."
  echo ""
  [ "$NO_OPEN" = 1 ] || open_browser "$url"
}

# =============================================================================================
# Isolation self-test (probe_mjs)

SELFTEST_NET=scimgg-sandbox-net-selftest
SELFTEST_PROBE=scimgg-sandbox-selftest-probe
SELFTEST_RELAY=scimgg-sandbox-proxy-selftest
SELFTEST_DIR=""

selftest_teardown() {
  docker rm -f "$SELFTEST_PROBE" "$SELFTEST_RELAY" scimgg-sandbox-selftest-none >/dev/null 2>&1 || true
  docker network rm "$SELFTEST_NET" >/dev/null 2>&1 || true
  [ -z "$SELFTEST_DIR" ] || rm -rf "$SELFTEST_DIR"
  SELFTEST_ACTIVE=0
}

# Addresses the dev server must not reach: every Docker network's gateway, the host's own
# addresses, and Docker Desktop's host-side addresses.
selftest_candidates() {
  # shellcheck disable=SC2046 # network ids are hex words
  docker network inspect --format '{{range .IPAM.Config}}{{.Gateway}} {{end}}' $(docker network ls -q) 2>/dev/null | tr ' ' '\n'
  if command -v ip >/dev/null 2>&1; then
    ip -o -4 addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1
  elif command -v ifconfig >/dev/null 2>&1; then
    ifconfig 2>/dev/null | awk '$1 == "inet" {print $2}' | sed 's/^addr://'
  fi
  printf '%s\n' 192.168.65.1 192.168.65.254
}

# Cached per daemon, engine version, probe and image, because runtimes differ (a Linux engine, the
# VM behind Docker Desktop, OrbStack or Colima) and a flag that isolates on one may not on another.
selftest() {
  local force=${1:-0} key marker log out rc relay_ip status candidates=() a i
  key=$(printf '%s|%s|%s|%s|%s\n' "$DOCKER_ID" "$DOCKER_VERSION" "$SELFTEST_VERSION" "$TOOLS_IMAGE" \
    "$(probe_mjs | sha256)" | sha256 | cut -c1-16)
  marker="$STATE/selftest/$key.ok"
  if [ "$force" = 0 ] && [ -z "${SCIMGG_SANDBOX_SELFTEST_EXTRA:-}" ] && [ -f "$marker" ]; then return 0; fi
  ensure_pulled "$TOOLS_IMAGE"
  note "isolation self-test on this Docker daemon (Docker $DOCKER_VERSION, $DOCKER_OS)"
  mkdir -p "$STATE/selftest"
  log="$STATE/selftest/last.log"
  SELFTEST_ACTIVE=1
  selftest_teardown
  SELFTEST_ACTIVE=1
  SELFTEST_DIR=$(mktemp -d "$STATE/selftest/rw.XXXXXX")
  : > "$log"
  status=0

  # A --network none container, and the ownership of what it writes into a bind mount.
  base_flags none
  rc=0
  out=$(docker run --rm "${FLAGS[@]}" --name scimgg-sandbox-selftest-none \
    --mount "$(ro "$TOOLS" /sandbox-tools)" --mount "$(rw "$SELFTEST_DIR" /rw)" \
    "$TOOLS_IMAGE" node /sandbox-tools/probe.mjs none /rw/owner 2>&1) || rc=$?
  printf '[no network]\n%s\n' "$out" >> "$log"
  { [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qx 'done 0'; } || status=1
  if [ ! -f "$SELFTEST_DIR/owner" ] || [ ! -O "$SELFTEST_DIR/owner" ]; then
    echo "FAIL a file the container wrote into a bind mount is not owned by you" >> "$log"
    status=1
  fi

  # The dev server's internal network, reached only through the relay.
  docker network create --internal -o com.docker.network.bridge.inhibit_ipv4=true \
    --label scimgg.sandbox=1 "$SELFTEST_NET" >/dev/null
  start_relay "$SELFTEST_RELAY" "$SELFTEST_PROBE" "$SELFTEST_NET" "$PORT_BASE"
  relay_ip=$(docker inspect -f "{{(index .NetworkSettings.Networks \"$SELFTEST_NET\").IPAddress}}" "$SELFTEST_RELAY")
  while IFS= read -r a; do
    [ -n "$a" ] && candidates+=("$a")
  done < <(selftest_candidates | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^127\.' | sort -u)
  # A test hook: extra addresses that must be unreachable, or `self`, which never is, to check that
  # a failure stops everything. It never records a pass.
  # shellcheck disable=SC2206 # deliberately split: a list of addresses, or `self`
  [ -z "${SCIMGG_SANDBOX_SELFTEST_EXTRA:-}" ] || candidates+=($SCIMGG_SANDBOX_SELFTEST_EXTRA)
  base_flags "$SELFTEST_NET"
  docker run -d "${FLAGS[@]}" --name "$SELFTEST_PROBE" --mount "$(ro "$TOOLS" /sandbox-tools)" \
    "$TOOLS_IMAGE" node /sandbox-tools/probe.mjs internal "$RELAY_PORT" "!$relay_ip" \
    ${candidates[@]+"${candidates[@]}"} >/dev/null
  i=0
  while :; do
    out=$(docker logs "$SELFTEST_PROBE" 2>&1 || true)
    case "$out" in *"done "*) break ;; esac
    i=$((i + 1))
    if [ "$i" -gt 60 ] || ! running "$SELFTEST_PROBE"; then break; fi
    sleep 0.5
  done
  printf '[internal network]\n%s\n' "$out" >> "$log"
  printf '%s\n' "$out" | grep -qx 'done 0' || status=1
  i=0
  while :; do
    out=$(curl --connect-timeout 2 --max-time 3 -fsS "http://127.0.0.1:$RELAY_PORT/" 2>/dev/null || true)
    case "$out" in scimgg-sandbox-probe*) break ;; esac
    i=$((i + 1))
    if [ "$i" -gt 10 ]; then
      echo "FAIL the relay on 127.0.0.1:$RELAY_PORT does not reach the internal network" >> "$log"
      status=1
      break
    fi
    sleep 0.5
  done
  [ "$status" -ne 0 ] || echo "ok   the relay on 127.0.0.1:$RELAY_PORT reaches the internal network" >> "$log"
  selftest_teardown

  if [ "$status" -ne 0 ]; then
    rm -f "$marker"
    grep -E '^(FAIL|\[)' "$log" >&2 || true
    die "the isolation self-test failed on this Docker daemon (full report: $log). The sandbox does not run where its isolation does not hold, and has no weaker mode. Report the lines above with 'docker version' and 'docker info'."
  fi
  note "self-test passed: $(grep -c '^ok' "$log") checks (report: $log)"
  [ -n "${SCIMGG_SANDBOX_SELFTEST_EXTRA:-}" ] || touch "$marker"
}

# =============================================================================================
# Disk and eviction

# "id|id|...|": the snapshots any sandbox container (running or not) uses.
sandbox_snapshot_ids() {
  docker ps -a --filter label=scimgg.sandbox=1 --format '{{.Label "scimgg.sandbox.sha"}}' | tr '\n' '|'
}

# Whether snapshot ID must stay: it is in PROTECTED, or a live run holds it.
snap_protected() {
  local id=$1 hold pid
  case "$PROTECTED" in *"|$id|"*) return 0 ;; esac
  for hold in "$STATE/snapshots/$id"/hold.*; do
    [ -e "$hold" ] || continue
    pid=${hold##*.}
    if kill -0 "$pid" 2>/dev/null; then return 0; fi
    rm -f "$hold"
  done
  return 1
}

snap_kb() {
  if [ ! -f "$1/size" ]; then size_kb "$1" > "$1/size"; fi
  cat "$1/size"
}

record_size() { size_kb "$SNAP" > "$SNAP/size" 2>/dev/null || true; }

remove_snapshot() {
  EVICTED_KB=$((EVICTED_KB + $(snap_kb "$1")))
  remove_tree "$1"
}

# Adds "N WHAT" to the one-line eviction note, if N > 0.
evicted() {
  [ "$1" = 0 ] || EVICTED="$EVICTED${EVICTED:+, }$1 $2"
}

# "|image|...|": the images this checkout runs: each pinned one, what it builds from it, and the
# tools image.
current_images() {
  local images="|${IMAGE:-}|$TOOLS_IMAGE|" word
  for word in $NODE_IMAGES; do
    images="$images${word#*=}|$(built_image_tag "${word%%=*}" "${word#*=}")|"
  done
  printf '%s' "$images"
}

# Runs with the lock held, before the current target is prepared.
evict() {
  EVICTED_KB=0
  EVICTED=""
  PROTECTED="|$ID|$(sandbox_snapshot_ids)"
  mkdir -p "$STATE/snapshots" "$STATE/node-modules"
  evict_snapshots
  evict_templates
  evict_images
  evict_seed_caches
  evict_tools
  # Leftovers of interrupted runs: working-tree archives and self-test directories over a day old.
  find "$STATE/tmp" "$STATE/selftest" -mindepth 1 -maxdepth 1 \( -name 'worktree.*' -o -name 'rw.*' \) \
    -mmin +1440 -exec rm -rf {} + 2>/dev/null || true
  [ -z "$EVICTED" ] || note "freed $(human_kb "$EVICTED_KB"): removed $EVICTED (see ./dev-sandbox status)"
}

# Snapshots of an older layout or unused for KEEP_DAYS; with --worktree, the tree's snapshots of
# earlier content; then the least recently used while snapshots and dependency sets exceed MAX_GB.
evict_snapshots() {
  local snap id t total=0 old=0 superseded=0 lru=0 max_kb=$((MAX_GB * 1048576)) oldest=()
  for snap in "$STATE"/snapshots/*/; do
    [ -d "$snap" ] || continue
    snap=${snap%/}
    id=${snap##*/}
    snap_protected "$id" && continue
    if [ "$(cat "$snap/format" 2>/dev/null)" != "$SNAPSHOT_FORMAT" ] || [ "$KEEP_DAYS" = 0 ] ||
      [ -n "$(find "$snap/used" -mmin +$((KEEP_DAYS * 1440)) 2>/dev/null)" ]; then
      remove_snapshot "$snap"
      old=$((old + 1))
    elif [ "$KIND" = worktree ] && [ "$(cat "$snap/source" 2>/dev/null)" = "$SOURCE" ]; then
      remove_snapshot "$snap"
      superseded=$((superseded + 1))
    fi
  done
  evicted "$old" "unused snapshot(s)"
  evicted "$superseded" "snapshot(s) of this working tree's earlier content"

  for snap in "$STATE"/snapshots/*/; do
    [ -d "$snap" ] && total=$((total + $(snap_kb "${snap%/}")))
  done
  for t in "$STATE"/node-modules/*/size; do
    [ -f "$t" ] && total=$((total + $(cat "$t")))
  done
  if [ "$total" -gt "$max_kb" ]; then
    while IFS= read -r t; do
      [ -n "$t" ] && oldest+=("${t%/used}")
    done < <(ls -1tr "$STATE"/snapshots/*/used 2>/dev/null || true)
    for snap in ${oldest[@]+"${oldest[@]}"}; do
      [ "$total" -gt "$max_kb" ] || break
      snap_protected "${snap##*/}" && continue
      total=$((total - $(snap_kb "$snap")))
      remove_snapshot "$snap"
      lru=$((lru + 1))
    done
  fi
  evicted "$lru" "least recently used snapshot(s) (over $MAX_GB GB)"
  TOTAL_KB=$total
}

# Dependency sets no snapshot uses, except the most recent few if built for an image still in use
# and within MAX_GB; sets of an older layout; and unfinished ones whose run has gone.
evict_templates() {
  local t key kb refs="|" current kept=0 n=0 max_kb=$((MAX_GB * 1048576))
  current=$(current_images)
  for t in "$STATE"/node-modules/*.partial.*; do
    [ -e "$t" ] || continue
    kill -0 "${t##*.}" 2>/dev/null || remove_tree "$t"
  done
  for t in "$STATE"/snapshots/*/template; do
    [ -f "$t" ] && refs="$refs$(cat "$t")|"
  done
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    key=${t%/used}
    key=${key##*/}
    case "$refs" in *"|$key|"*) continue ;; esac
    [ "$key" != "${TEMPLATE_KEY:-}" ] || continue
    case "$current" in
      *"|$(cat "$STATE/node-modules/$key/image" 2>/dev/null)|"*)
        if [ "$kept" -lt "$TEMPLATES_KEEP" ] && [ "$TOTAL_KB" -le "$max_kb" ]; then
          kept=$((kept + 1))
          continue
        fi
        ;;
    esac
    kb=$(cat "$STATE/node-modules/$key/size" 2>/dev/null || echo 0)
    remove_tree "$STATE/node-modules/$key"
    TOTAL_KB=$((TOTAL_KB - kb))
    EVICTED_KB=$((EVICTED_KB + kb))
    n=$((n + 1))
  done < <(ls -1t "$STATE"/node-modules/*/used 2>/dev/null || true)
  for t in "$STATE"/node-modules/*/; do
    [ -d "$t" ] || continue
    t=${t%/}
    case "$t" in *.partial.*) continue ;; esac
    if [ "$(cat "$t/format" 2>/dev/null)" != "$TEMPLATE_FORMAT" ]; then
      EVICTED_KB=$((EVICTED_KB + $(size_kb "$t")))
      remove_tree "$t"
      rm -f "$t.ready"
      n=$((n + 1))
    fi
  done
  evicted "$n" "unused dependency set(s)"
}

# This script's own images once nothing pins them: tags it built (labeled scimgg-sandbox-node),
# and image references it pulled itself (pulled-images). Never other images, and never build cache.
evict_images() {
  local keep t ref n=0 left=""
  keep=$(current_images)
  for t in "$STATE"/node-modules/*/image; do
    [ -f "$t" ] && keep="$keep$(cat "$t")|"
  done
  while IFS= read -r ref; do
    case "$ref" in scimgg-sandbox-node:*) ;; *) continue ;; esac
    case "$keep" in *"|$ref|"*) continue ;; esac
    if docker image rm "$ref" >/dev/null 2>&1; then n=$((n + 1)); fi
  done < <(docker image ls --filter label=scimgg.sandbox=1 --format '{{.Repository}}:{{.Tag}}' 2>/dev/null || true)
  if [ -f "$STATE/pulled-images" ]; then
    while IFS= read -r ref; do
      [ -n "$ref" ] || continue
      case "$left" in *"|$ref|"*) continue ;; esac
      case "$keep" in
        *"|$ref|"*) left="$left|$ref|" ;;
        *)
          if docker image rm "$ref" >/dev/null 2>&1; then n=$((n + 1))
          elif docker image inspect "$ref" >/dev/null 2>&1; then left="$left|$ref|"   # in use
          fi
          ;;
      esac
    done < "$STATE/pulled-images"
    printf '%s' "$left" | tr '|' '\n' | grep -v '^$' > "$STATE/pulled-images.new" || true
    mv "$STATE/pulled-images.new" "$STATE/pulled-images"
  fi
  evicted "$n" "unused image(s)"
}

# Game caches no remaining snapshot links (a tree's .setup-cache/ names its pinned cache), except
# the newest, which the next commit most likely pins too. Icons and healthbars are small (about
# 25 MB, growing only when RuneLite re-renders one) and stay until `clean --all`.
evict_seed_caches() {
  local refs="|" f id n=0 first=1
  for f in "$STATE"/snapshots/*/tree/.setup-cache/openrs2-*-disk.zip; do
    [ -L "$f" ] || [ -e "$f" ] || continue
    id=${f##*/openrs2-}
    refs="$refs${id%-disk.zip}|"
  done
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ "$first" = 1 ]; then first=0; continue; fi
    id=${f##*/}
    case "$refs" in *"|${id%-disk.zip}|"*) continue ;; esac
    EVICTED_KB=$((EVICTED_KB + $(size_kb "$f")))
    rm -f "$f"
    n=$((n + 1))
  done < <(ls -1t "$STATE"/seed/cache/*-disk.zip 2>/dev/null || true)
  evicted "$n" "unused game cache(s)"
}

# Helper directories of other versions of this script. One a running container mounts cannot be
# removed by a later version, so they go only when no sandbox container exists.
evict_tools() {
  local d
  [ -z "$(docker ps -aq --filter label=scimgg.sandbox=1)" ] || return 0
  for d in "$STATE"/tools/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    [ "$d" = "$TOOLS" ] || remove_tree "$d"
  done
}

disk_report() {
  local n_snap=0 snap_total=0 n_tpl=0 tpl_kb=0 snap t ref word images listing image_lines="" n_img=0 size id
  for snap in "$STATE"/snapshots/*/; do
    [ -d "$snap" ] || continue
    n_snap=$((n_snap + 1))
    snap_total=$((snap_total + $(snap_kb "${snap%/}")))
  done
  for t in "$STATE"/node-modules/*/; do
    [ -d "$t" ] || continue
    n_tpl=$((n_tpl + 1))
    tpl_kb=$((tpl_kb + $(cat "${t%/}/size" 2>/dev/null || size_kb "$t")))
  done
  # The pinned images, the ones this script built, and any it pulled that eviction has not yet
  # removed, with Docker's own size figures (a containerd image store's inspect size is compressed).
  images=$( {
    for word in $NODE_IMAGES; do echo "${word#*=}"; done
    echo "$TOOLS_IMAGE"
    docker image ls --filter label=scimgg.sandbox=1 --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep '^scimgg-sandbox-node:' || true
    cat "$STATE/pulled-images" 2>/dev/null || true
  } | sort -u)
  listing=$(docker image ls --no-trunc --format '{{.ID}}|{{.Size}}' 2>/dev/null || true)
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    id=$(docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null) || continue
    size=$(printf '%s\n' "$listing" | awk -F'|' -v i="$id" '$1 == i { print $2; exit }')
    n_img=$((n_img + 1))
    image_lines="$image_lines$(printf '    %-40s %s' "$(printf '%s' "$ref" | cut -c1-40)" "$size")
"
  done <<< "$images"
  echo "Disk, under $STATE (and Docker):"
  printf '  %-22s %3s  %s\n' "snapshots" "$n_snap" "$(human_kb "$snap_total")"
  printf '  %-22s %3s  %s\n' "dependency sets" "$n_tpl" "$(human_kb "$tpl_kb")"
  printf '  %-22s %3s  %s   (emptied above %s MB)\n' "npm download cache" "" "$(human_kb "$(size_kb "$STATE/npm-cache")")" "$NPM_CACHE_MAX_MB"
  printf '  %-22s %3s  %s\n' "seeds" "" "$(human_kb "$(size_kb "$STATE/seed")")"
  printf '  %-22s %3s  %s\n' "browser profile" "" "$(human_kb "$(size_kb "$STATE/browser-profile")")"
  printf '  %-22s %3s  (as Docker counts them; a built image includes its base)\n' "images" "$n_img"
  printf '%s' "$image_lines"
  echo ""
  echo "Limits: snapshots unused for $KEEP_DAYS day(s) are removed, and the least recently used while"
  echo "snapshots and dependency sets exceed $MAX_GB GB (SCIMGG_SANDBOX_KEEP_DAYS, SCIMGG_SANDBOX_MAX_GB)."
  echo "Dependency sets, images and game caches nothing uses go too. ./dev-sandbox clean frees it all."
}

# =============================================================================================
# Commands

prepare() {
  target_settings
  pick_image
  template_key
  acquire_lock
  evict
  make_snapshot
  check_seeds
  ensure_template
  prepare_snapshot
  release_lock
  printf '[sandbox] %s  %s  (%s tree, Node %s)\n' "$ID" "$SOURCE" "$VARIETY" "$NODE_MAJOR" >&2
}

cmd_build() {
  local rc=0
  run_in_snapshot build bash -c "$BUILD_SCRIPT" build ${EXTRA[@]+"${EXTRA[@]}"} || rc=$?
  echo "[sandbox] build output: $TREE/dist (written by sandboxed code; treat it as untrusted)"
  return "$rc"
}

cmd_shell() {
  if [ ${#EXTRA[@]} -gt 0 ]; then run_in_snapshot shell "${EXTRA[@]}"; else run_in_snapshot shell bash; fi
}

# Trusted downloads (SEED_FETCH) in a container with network that has the snapshot only read-only,
# as data, and writes only to the seed directory.
cmd_seed() {
  local flags=() rc=0
  target_settings
  acquire_lock
  evict
  make_snapshot
  release_lock
  mkdir -p "$STATE/seed"
  if [ "$WANT_TEST_CACHE" = 1 ]; then
    if [ -n "$(test_cache_dir)" ]; then note "test cache: $(test_cache_dir)/disk.zip is already there"
    else flags+=(--test-cache)
    fi
  fi
  note "downloading what $SOURCE pins, from its pinned sources only, into $STATE/seed; nothing from the tree runs"
  base_flags bridge
  step "scimgg-sandbox-seed-$SHORT" "${FLAGS[@]}" --label "scimgg.sandbox.sha=$ID" \
    --mount "$(ro "$TREE" /work)" --mount "$(ro "$TOOLS" /sandbox-tools)" \
    --mount "$(rw "$STATE/seed" /seed)" ${SEED_FLAGS[@]+"${SEED_FLAGS[@]}"} \
    "$TOOLS_IMAGE" "${SEED_FETCH[@]}" ${flags[@]+"${flags[@]}"} || rc=$?
  [ "$rc" -eq 0 ] || die "downloading the seeds failed"
}

cmd_status() {
  echo "Sandboxes:"
  echo ""
  local rows others snap name state port sha source mark
  rows=$(docker ps -a --filter label=scimgg.sandbox.role=dev \
    --format '{{.State}}|{{.Label "scimgg.sandbox.port"}}|{{.Label "scimgg.sandbox.sha"}}|{{.Label "scimgg.sandbox.source"}}')
  if [ -z "$rows" ]; then
    echo "  no dev servers"
  else
    while IFS='|' read -r state port sha source; do
      mark="○ $state"
      [ "$state" = running ] && mark="● running"
      printf "  %-12s  :%-5s  %s  %s\n" "$mark" "$port" "${sha:0:12}${sha:40:26}" "$source"
    done <<< "$rows"
  fi
  others=$(docker ps -a --filter label=scimgg.sandbox=1 --format '{{.Names}}' | grep -v -e '-dev-' -e '-proxy-' || true)
  if [ -n "$others" ]; then
    printf '\n  other sandbox containers:\n'
    printf '%s\n' "$others" | sed 's/^/    /'
  fi
  echo ""
  if [ -d "$STATE/snapshots" ]; then
    for snap in "$STATE"/snapshots/*/; do
      [ -d "$snap" ] || continue
      name=$(basename "$snap")
      printf "  snapshot %s  %-8s %s%s\n" "${name:0:12}${name:40:26}" "$(human_kb "$(snap_kb "${snap%/}")")" \
        "$(cat "$snap/source" 2>/dev/null || echo '?')" "$([ -f "$snap/prepared" ] || echo ' (not prepared)')"
    done
    echo ""
  fi
  disk_report
  echo ""
}

stop_all() {
  local ids nets
  ids=$(docker ps -aq --filter label=scimgg.sandbox=1)
  # shellcheck disable=SC2086 # container ids are hex words
  [ -z "$ids" ] || docker rm -f $ids >/dev/null
  nets=$(docker network ls -q --filter label=scimgg.sandbox=1)
  # shellcheck disable=SC2086 # network ids are hex words
  [ -z "$nets" ] || docker network rm $nets >/dev/null
  echo "Stopped every sandbox"
}

clean_target() {
  local snap
  stop_target >/dev/null
  if [ "$KIND" = worktree ]; then
    for snap in "$STATE"/snapshots/*-worktree-*/; do
      [ "$(cat "$snap/source" 2>/dev/null)" = "$SOURCE" ] || continue
      remove_tree "$snap"
      echo "Removed snapshot $(basename "$snap")"
    done
  else
    remove_tree "$SNAP"
    echo "Removed snapshot $SHORT"
  fi
}

clean_all() {
  local everything=$1 ref repo
  stop_all
  remove_tree "$STATE/snapshots"
  remove_tree "$STATE/node-modules"
  remove_tree "$STATE/tmp"
  if [ "$everything" = 0 ]; then
    echo "Removed snapshots and installed dependencies under $STATE (kept the npm download cache and seeds)"
    return 0
  fi
  # With no pins left, eviction removes every image this script built or pulled.
  ID="" IMAGE="" NODE_IMAGES="" TOOLS_IMAGE=""
  EVICTED=""
  evict_images
  remove_tree "$STATE"
  repo=$(current_repo 2>/dev/null || true)
  if [ -n "$repo" ]; then
    git -C "$repo" for-each-ref --format='%(refname)' refs/sandbox/ | while IFS= read -r ref; do
      git -C "$repo" update-ref -d "$ref"
    done
  fi
  echo "Removed everything under $STATE, this script's images and refs/sandbox/ in $repo"
}

# =============================================================================================
# main

# Everything runs from inside main, which bash has read in full before it starts, so replacing this
# file during a long test run cannot make the running copy read a half-changed script.
main() {
  CMD=dev
  case "${1:-}" in
    dev | test | build | shell | seed | selftest | status | stop | clean) CMD=$1; shift ;;
    help) usage; exit 0 ;;
  esac
  local kind=commit spec=HEAD rc=0
  NO_OPEN=0 ALL=0 TARGET_ARGS="" TARGET_GIVEN=0 WANT_TEST_CACHE=0 VARIETY="" KIND=commit IMAGE=""
  EXTRA=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --pr) [ $# -ge 2 ] || die "--pr needs a number"; kind=pr spec=$2 TARGET_ARGS="--pr $2" TARGET_GIVEN=1; shift 2 ;;
      --worktree) kind=worktree TARGET_ARGS="--worktree" TARGET_GIVEN=1; shift ;;
      --stop | --status)
        [ "$CMD" = dev ] || die "$1 goes without a command; use './dev-sandbox ${1#--}'"
        CMD=${1#--}
        shift
        ;;
      --no-open) NO_OPEN=1; shift ;;
      --all) ALL=1; shift ;;
      --test-cache) WANT_TEST_CACHE=1; shift ;;
      --) shift; EXTRA=("$@"); break ;;
      -h | --help) usage; exit 0 ;;
      -*) die "unknown option '$1'; see ./dev-sandbox --help" ;;
      *) [ "$TARGET_GIVEN" = 0 ] || die "only one TARGET"; spec=$1 TARGET_ARGS=$1 TARGET_GIVEN=1; shift ;;
    esac
  done

  detect_platform
  [ "$HOST_UID" -ne 0 ] || die "run as your normal user, not root"
  read_limits
  preflight_host
  preflight_docker
  ensure_identity
  ensure_tools
  case "$CMD" in
    status | stop | clean) ;;
    selftest) selftest 1; exit 0 ;;
    *) selftest ;;
  esac

  case "$CMD" in
    dev) resolve_target "$kind" "$spec"; prepare; start_dev ;;
    test) resolve_target "$kind" "$spec"; prepare; run_in_snapshot test npm test ${EXTRA[@]+-- "${EXTRA[@]}"} || rc=$? ;;
    build) resolve_target "$kind" "$spec"; prepare; cmd_build || rc=$? ;;
    shell) resolve_target "$kind" "$spec"; prepare; cmd_shell || rc=$? ;;
    seed) resolve_target "$kind" "$spec"; cmd_seed ;;
    status) cmd_status ;;
    stop)
      if [ "$ALL" = 1 ]; then stop_all; else resolve_target "$kind" "$spec" local; stop_target; fi
      ;;
    clean)
      if [ "$ALL" = 1 ]; then clean_all 1
      elif [ "$TARGET_GIVEN" = 1 ]; then resolve_target "$kind" "$spec" local; clean_target
      else clean_all 0
      fi
      ;;
  esac
  return "$rc"
}

# =============================================================================================
# Embedded helpers. Each is emitted verbatim (quoted heredocs: no shell expansion inside), written
# by ensure_tools to $STATE/tools/<hash>/ and mounted read-only at /sandbox-tools. They run in
# containers and read the snapshot only as data.

# The runtime image: the pinned node -slim image plus PACKAGES (SANDBOX_APT_PACKAGES).
dockerfile_text() {
  cat <<'DOCKERFILE'
ARG NODE_IMAGE
FROM ${NODE_IMAGE}
ARG PACKAGES
RUN apt-get update \
  && apt-get install -y --no-install-recommends ${PACKAGES} \
  && rm -rf /var/lib/apt/lists/*
LABEL scimgg.sandbox=1
DOCKERFILE
}

# The TCP relay: joins the dev server's internal network and the default bridge, and is the only
# way in. It forwards to one fixed destination, so the app cannot use it to reach anything else;
# plain TCP, so Vite's HMR websocket passes through unchanged.
proxy_mjs() {
  cat <<'JS'
import net from 'node:net';

const port = Number(process.env.SANDBOX_PORT);
const target = process.env.SANDBOX_TARGET;
if (!Number.isInteger(port) || port <= 0 || !target) {
  console.error('[sandbox-proxy] SANDBOX_PORT and SANDBOX_TARGET are required');
  process.exit(64);
}

net
  .createServer((client) => {
    const upstream = net.connect(port, target);
    const close = () => {
      client.destroy();
      upstream.destroy();
    };
    client.on('error', close).on('close', close);
    upstream.on('error', close).on('close', close);
    client.pipe(upstream);
    upstream.pipe(client);
  })
  .listen(port, '0.0.0.0', () => console.log(`[sandbox-proxy] :${port} -> ${target}:${port}`));
JS
}

# The isolation probe, run with the real flags:
#   probe.mjs none OWNER_FILE        no interface but lo, no route, DNS or internet; writes
#                                    OWNER_FILE so the host can check its ownership
#   probe.mjs internal PORT ADDR...  no default route, DNS or internet, none of ADDR and no
#                                    host.docker.internal-style name reachable (`!ADDR` excludes
#                                    one); then answers HTTP on PORT, for the relay check
# It prints `ok`/`FAIL` per check, then `done <failures>`. Only a "no route" error counts as
# unreachable: a refused or reset connection means something answered, and a timeout proves nothing.
probe_mjs() {
  cat <<'JS'
import dns from 'node:dns/promises';
import { existsSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import http from 'node:http';
import net from 'node:net';
import os from 'node:os';

const UNREACHABLE = new Set(['ENETUNREACH', 'EHOSTUNREACH', 'EADDRNOTAVAIL', 'EACCES', 'EPERM']);
const CONNECT_TIMEOUT_MS = 6000;
const [mode, arg, ...given] = process.argv.slice(2);
let failures = 0;

function report(ok, what) {
  if (!ok) failures++;
  console.log(`${ok ? 'ok  ' : 'FAIL'} ${what}`);
}

/** Resolves to 'connected', 'timeout' or the connect error's code. */
function connect(host, port) {
  return new Promise((resolve) => {
    const socket = net.connect({ host, port, timeout: CONNECT_TIMEOUT_MS });
    const done = (outcome) => {
      socket.destroy();
      resolve(outcome);
    };
    socket.once('connect', () => done('connected'));
    socket.once('timeout', () => done('timeout'));
    socket.once('error', (err) => done(err.code ?? String(err)));
  });
}

async function mustNotReach(host, port, label) {
  const outcome = await connect(host, port);
  report(UNREACHABLE.has(outcome), `${label} ${host}:${port} unreachable (${outcome})`);
}

async function mustNotResolve(name) {
  try {
    const { address } = await dns.lookup(name);
    report(false, `DNS ${name} does not resolve (resolved to ${address})`);
  } catch (err) {
    report(true, `DNS ${name} does not resolve (${err.code})`);
  }
}

function interfaces() {
  return readdirSync('/sys/class/net').sort();
}

/** Routes with destination 0.0.0.0/0 or ::/0. */
function defaultRoutes() {
  const v4 = readFileSync('/proc/net/route', 'utf-8')
    .split('\n')
    .slice(1)
    .filter((line) => line.split(/\s+/)[1] === '00000000');
  const v6 = existsSync('/proc/net/ipv6_route')
    ? readFileSync('/proc/net/ipv6_route', 'utf-8')
        .split('\n')
        .filter((line) => line.startsWith('00000000000000000000000000000000 00') && !/ lo$/.test(line.trim()))
    : [];
  return [...v4, ...v6];
}

const internet = () =>
  Promise.all([
    mustNotResolve('example.com'),
    mustNotReach('1.1.1.1', 443, 'internet'),
    mustNotReach('8.8.8.8', 53, 'internet'),
    mustNotReach('2606:4700:4700::1111', 443, 'internet'),
  ]);

const ipv4ToInt = (ip) => ip.split('.').reduce((n, part) => n * 256 + Number(part), 0);
const intToIpv4 = (n) => [24, 16, 8, 0].map((shift) => Math.floor(n / 2 ** shift) % 256).join('.');

/** The first and last host address of each of this container's subnets, which a gateway would use. */
function subnetEdges() {
  const own = [];
  const edges = [];
  for (const addresses of Object.values(os.networkInterfaces())) {
    for (const a of addresses ?? []) {
      if (a.family !== 'IPv4' || a.internal) continue;
      own.push(a.address);
      const ip = ipv4ToInt(a.address);
      const mask = ipv4ToInt(a.netmask);
      const network = ip - (ip % (2 ** 32 - mask));
      const broadcast = network + (2 ** 32 - mask) - 1;
      edges.push(intToIpv4(network + 1), intToIpv4(broadcast - 1));
    }
  }
  return { own, edges: edges.filter((e) => !own.includes(e)) };
}

async function hostNames() {
  const names = ['host.docker.internal', 'gateway.docker.internal', 'host.lima.internal', 'host.orb.internal'];
  const found = [];
  for (const name of names) {
    try {
      const all = await dns.lookup(name, { all: true });
      report(false, `DNS ${name} does not resolve (resolved to ${all.map((a) => a.address).join(', ')})`);
      found.push(...all.map((a) => a.address));
    } catch (err) {
      report(true, `DNS ${name} does not resolve (${err.code})`);
    }
  }
  return found;
}

if (mode === 'none') {
  const ifaces = interfaces();
  report(ifaces.length === 1 && ifaces[0] === 'lo', `only the loopback interface (${ifaces.join(', ')})`);
  report(defaultRoutes().length === 0, 'no default route');
  await internet();
  writeFileSync(arg, 'scimgg-sandbox self-test\n');
  console.log(`done ${failures}`);
} else if (mode === 'internal') {
  const port = Number(arg);
  const ifaces = interfaces().filter((name) => name !== 'lo');
  report(ifaces.length === 1, `one interface besides loopback (${ifaces.join(', ')})`);
  const routes = defaultRoutes();
  report(routes.length === 0, `no default route${routes.length ? ` (${routes.join('; ')})` : ''}`);
  await internet();
  const { own, edges } = subnetEdges();
  const named = await hostNames();
  const excluded = new Set(given.filter((a) => a.startsWith('!')).map((a) => a.slice(1)));
  // `self` stands for this container's own address: reachable by definition, so the host can prove
  // that a reachable address makes the test fail.
  const listed = given
    .filter((a) => !a.startsWith('!'))
    .flatMap((a) => (a === 'self' ? own : [a]))
    .filter((a) => net.isIP(a));
  const targets = [...new Set([...listed, ...edges.filter((e) => !excluded.has(e)), ...named])];
  await Promise.all(targets.map((host) => mustNotReach(host, 9, 'gateway or host')));
  console.log(`done ${failures}`);
  http.createServer((_req, res) => res.end(`scimgg-sandbox-probe ${failures}\n`)).listen(port, '0.0.0.0');
} else {
  console.error('Usage: node probe.mjs none OWNER_FILE | internal PORT [ADDR...]');
  process.exit(64);
}
JS
}

# Seed data. `check` and `assets` run offline, before any of the tree's code in their container;
# `fetch` is `./dev-sandbox seed`, with network. All read the tree at /work only as data (regular
# expressions and JSON.parse, never an import). The seed directory, at /seed:
#   cache/<id>-disk.zip   OpenRS2 game caches, checked against the tree's pin
#   blobs/<sha256>        small pinned files (item icons, healthbars), named by their hash so that
#                         trees pinning different bytes for the same icon never collide
#   test-cache/disk.zip   the golden real-cache test fixture, with `fetch --test-cache`
# `fetch` downloads only what the tree pins, only from OpenRS2, RuneLite's icon host and RuneLite's
# repository, checks each file against its pin before saving it, and writes only under /seed.
seed_mjs() {
  cat <<'JS'
import { createHash } from 'node:crypto';
import { copyFileSync, existsSync, mkdirSync, readFileSync, renameSync, symlinkSync, writeFileSync } from 'node:fs';
import https from 'node:https';
import path from 'node:path';

const WORK = '/work';
const SEED = '/seed';
const BLOBS_DIR = path.join(SEED, 'blobs');
const TEST_CACHE = path.join(SEED, 'test-cache', 'disk.zip');
const OPENRS2 = 'https://archive.openrs2.org';
const ICONS = 'https://static.runelite.net/cache/item/icon';
const RUNELITE_RAW = 'https://raw.githubusercontent.com/runelite/runelite';
const HEALTHBAR_PATH = 'runelite-client/src/main/resources/net/runelite/client/plugins/interfacestyles/2010/healthbar';
const ALLOWED = [
  { host: 'archive.openrs2.org', path: '/' },
  { host: 'static.runelite.net', path: '/cache/item/icon/' },
  { host: 'raw.githubusercontent.com', path: '/runelite/runelite/' },
];
const ATTEMPTS = 3;
const TIMEOUT_MS = 60_000;
/** The tree mirrors about 5,300; a list far longer is not a real manifest. */
const MAX_ICONS = 50_000;
const SHA256 = /^[0-9a-f]{64}$/;

const log = (message) => console.log(`[sandbox-seed] ${message}`);
const mb = (bytes) => `${(bytes / 1024 / 1024).toFixed(0)} MB`;
const sha256 = (bytes) => createHash('sha256').update(bytes).digest('hex');
const sha256File = (file) => sha256(readFileSync(file));
const cacheFile = (id) => path.join(SEED, 'cache', `${id}-disk.zip`);
const blobFile = (pin) => path.join(BLOBS_DIR, pin);

function readTree(file) {
  const full = path.join(WORK, file);
  return existsSync(full) ? readFileSync(full, 'utf-8') : null;
}

/** The tree's pinned game cache (scripts/pinnedCache.ts), or null if it names none. */
function pinnedCache() {
  const source = readTree('scripts/pinnedCache.ts');
  const id = source?.match(/PINNED_CACHE\s*=\s*\{\s*id:\s*(\d+)/)?.[1];
  const pin = source?.match(/diskZipSha256:\s*'([0-9a-f]{64})'/)?.[1];
  return id && pin ? { id: Number(id), sha256: pin } : null;
}

/** Item icons the tree mirrors (scripts/item-icon-manifest.json): `[id, sha256]` pairs, and the ids without a pin. */
function itemIcons() {
  const json = readTree('scripts/item-icon-manifest.json');
  if (!json) return { pinned: [], unpinned: [] };
  const manifest = JSON.parse(json);
  const pins = manifest.sha256 && typeof manifest.sha256 === 'object' ? manifest.sha256 : {};
  const ids = new Set(
    [...(Array.isArray(manifest.mirrored) ? manifest.mirrored : []), ...Object.keys(pins)]
      .map(String)
      .filter((id) => /^\d+$/.test(id)),
  );
  const pinned = [];
  const unpinned = [];
  for (const id of ids) {
    if (SHA256.test(pins[id] ?? '')) pinned.push([id, pins[id]]);
    else unpinned.push(id);
  }
  return { pinned, unpinned };
}

/** RuneLite's healthbars (scripts/assets/runeliteHealthbars.ts): the pinned commit and `[name, sha256]` pairs. */
function healthbars() {
  const source = readTree('scripts/assets/runeliteHealthbars.ts');
  const commit = source?.match(/RUNELITE_COMMIT\s*=\s*'([0-9a-f]{40})'/)?.[1];
  const block = source?.match(/HEALTHBAR_PINS[^=]*=\s*\{([^}]*)\}/)?.[1] ?? '';
  const files = [...block.matchAll(/'([a-z0-9_]+\.png)':\s*'([0-9a-f]{64})'/g)].map((m) => [m[1], m[2]]);
  return commit && files.length > 0 ? { commit, files } : null;
}

/** The golden real-cache test fixture (src/test/helpers/real-cache.ts) and its pin, if the tree has both. */
function goldenTestCache() {
  const id = readTree('src/test/helpers/real-cache.ts')?.match(/OPENRS2_CACHE_ID\s*=\s*(\d+)/)?.[1];
  const goldens = readTree('src/render/environment/__tests__/animatedLocDrawGoldens.json');
  const pin = goldens ? JSON.parse(goldens)?.cache?.sha256 : undefined;
  return id && SHA256.test(pin ?? '') ? { id: Number(id), sha256: pin } : null;
}

/** Reports what the tree needs and the seeds lack; exits 3 if anything is missing. */
function check() {
  const missing = [];
  const pinned = pinnedCache();
  if (!pinned) {
    missing.push('scripts/pinnedCache.ts names no pinned cache this script can read');
  } else if (!existsSync(cacheFile(pinned.id))) {
    missing.push(`the pinned game cache ${pinned.id} (about 200 MB)`);
  } else if (sha256File(cacheFile(pinned.id)) !== pinned.sha256) {
    missing.push(`the pinned game cache ${pinned.id}: the saved copy does not match its pin`);
  }
  const icons = itemIcons();
  const absent = icons.pinned.filter(([, pin]) => !existsSync(blobFile(pin))).length;
  if (absent > 0) missing.push(`${absent} item icon(s) matching the tree's pins (about 4 KB each)`);
  if (icons.unpinned.length > 0) log(`note: ${icons.unpinned.length} item icon(s) have no pin; setup decides`);
  const bars = healthbars();
  const barsAbsent = bars ? bars.files.filter(([, pin]) => !existsSync(blobFile(pin))).length : 0;
  if (barsAbsent > 0) missing.push(`${barsAbsent} RuneLite healthbar(s)`);
  for (const item of missing) console.error(`[sandbox-seed] missing: ${item}`);
  process.exit(missing.length > 0 ? 3 : 0);
}

/** Copies pinned blobs to `dir/<name>` for each `[name, pin]`. Returns how many were copied. */
function copyBlobs(entries, dir) {
  mkdirSync(dir, { recursive: true });
  let copied = 0;
  for (const [name, pin] of entries) {
    if (!existsSync(blobFile(pin))) continue;
    copyFileSync(blobFile(pin), path.join(dir, name));
    copied++;
  }
  return copied;
}

/** Lays the seeds where `npm run setup -- --offline` looks for them. */
function assets() {
  const icons = itemIcons().pinned.map(([id, pin]) => [`${id}.png`, pin]);
  log(`item icons: ${copyBlobs(icons, path.join(WORK, 'public/assets/items'))} copied into public/assets/items/`);
  const bars = healthbars();
  if (bars) {
    const copied = copyBlobs(bars.files, path.join(WORK, 'public/assets/ui/healthbar'));
    log(`healthbars: ${copied} copied into public/assets/ui/healthbar/`);
  }
  const pinned = pinnedCache();
  if (!pinned || !existsSync(cacheFile(pinned.id))) {
    throw new Error('[sandbox-seed] the pinned cache is missing; run ./dev-sandbox seed');
  }
  // A link into the read-only seed, so the 200 MB cache is not copied into every snapshot. Setup
  // checks its size and SHA-256 against the pin before using it.
  const dest = path.join(WORK, '.setup-cache', `openrs2-${pinned.id}-disk.zip`);
  mkdirSync(path.dirname(dest), { recursive: true });
  if (!existsSync(dest)) symlinkSync(cacheFile(pinned.id), dest);
  log(`pinned cache ${pinned.id}: .setup-cache/ links the read-only seed`);
}

/** GETs `url` into memory, following redirects only within the allowed hosts and paths. */
function get(url, redirects = 5) {
  return new Promise((resolve, reject) => {
    const { hostname, pathname, protocol } = new URL(url);
    if (protocol !== 'https:' || !ALLOWED.some((a) => a.host === hostname && pathname.startsWith(a.path))) {
      reject(new Error(`refusing to fetch ${url}`));
      return;
    }
    const req = https.get(url, (res) => {
      if ([301, 302, 303, 307, 308].includes(res.statusCode) && res.headers.location && redirects > 0) {
        res.resume();
        resolve(get(new URL(res.headers.location, url).href, redirects - 1));
        return;
      }
      if (res.statusCode !== 200) {
        res.resume();
        reject(new Error(`HTTP ${res.statusCode} from ${url}`));
        return;
      }
      const chunks = [];
      res.on('data', (chunk) => chunks.push(chunk));
      res.on('end', () => resolve(Buffer.concat(chunks)));
      res.on('error', reject);
    });
    req.setTimeout(TIMEOUT_MS, () => req.destroy(new Error(`timed out fetching ${url}`)));
    req.on('error', reject);
  });
}

async function getPinned(url, pin) {
  for (let attempt = 1; ; attempt++) {
    try {
      const bytes = await get(url);
      if (sha256(bytes) !== pin) throw new Error(`${url} does not match its pin ${pin}`);
      return bytes;
    } catch (err) {
      if (attempt >= ATTEMPTS) throw err;
    }
  }
}

function writeAtomically(file, bytes) {
  mkdirSync(path.dirname(file), { recursive: true });
  const tmp = `${file}.partial-${process.pid}`;
  writeFileSync(tmp, bytes);
  renameSync(tmp, file);
}

/** Downloads a game cache archive unless a copy matching its pin is already there. */
async function fetchCache(url, file, pin, what) {
  if (existsSync(file) && sha256File(file) === pin) return log(`${what}: already saved`);
  log(`${what}: downloading ${url} (about 200 MB)`);
  const bytes = await getPinned(url, pin);
  writeAtomically(file, bytes);
  log(`${what}: saved ${mb(bytes.length)}, matching its pin`);
}

/** Downloads each `[url, pin]` whose blob is missing, eight at a time. */
async function fetchBlobs(what, entries) {
  const todo = entries.filter(([, pin]) => !existsSync(blobFile(pin)));
  if (todo.length === 0) return log(`${what}: all ${entries.length} present`);
  log(`${what}: downloading ${todo.length} of ${entries.length}`);
  mkdirSync(BLOBS_DIR, { recursive: true });
  const failed = [];
  let next = 0;
  let done = 0;
  const worker = async () => {
    while (next < todo.length) {
      const [url, pin] = todo[next++];
      try {
        writeAtomically(blobFile(pin), await getPinned(url, pin));
      } catch (err) {
        failed.push(err instanceof Error ? err.message : String(err));
      }
      if (++done % 500 === 0) log(`${what}: ${done}/${todo.length}`);
    }
  };
  await Promise.all(Array.from({ length: 8 }, worker));
  if (failed.length > 0) {
    throw new Error(`${failed.length} of the ${what} not fetched:\n  ${failed.slice(0, 10).join('\n  ')}`);
  }
  log(`${what}: ${todo.length} saved`);
}

async function fetchSeeds(flags) {
  const pinned = pinnedCache();
  if (!pinned) throw new Error('scripts/pinnedCache.ts names no pinned cache this script can read');
  const url = `${OPENRS2}/caches/runescape/${pinned.id}/disk.zip`;
  await fetchCache(url, cacheFile(pinned.id), pinned.sha256, `pinned game cache ${pinned.id}`);

  const icons = itemIcons();
  if (icons.pinned.length > MAX_ICONS) {
    throw new Error(`the tree lists ${icons.pinned.length} item icons; refusing more than ${MAX_ICONS}`);
  }
  await fetchBlobs(
    'item icons',
    icons.pinned.map(([id, pin]) => [`${ICONS}/${id}.png`, pin]),
  );
  if (icons.unpinned.length > 0) log(`item icons: ${icons.unpinned.length} have no pin and were skipped`);

  const bars = healthbars();
  if (bars) {
    await fetchBlobs(
      'healthbars',
      bars.files.map(([name, pin]) => [`${RUNELITE_RAW}/${bars.commit}/${HEALTHBAR_PATH}/${name}`, pin]),
    );
  }

  if (flags.includes('--test-cache')) {
    const golden = goldenTestCache();
    if (!golden) log('test cache: the tree names no pinned golden cache; skipped');
    else {
      const testUrl = `${OPENRS2}/caches/runescape/${golden.id}/disk.zip`;
      await fetchCache(testUrl, TEST_CACHE, golden.sha256, `golden test cache ${golden.id}`);
    }
  }
  log('done');
}

const [command, ...flags] = process.argv.slice(2);
try {
  if (command === 'check') check();
  else if (command === 'assets') assets();
  else if (command === 'fetch') await fetchSeeds(flags);
  else {
    console.error('Usage: node seed.mjs check | assets | fetch [--test-cache]');
    process.exit(64);
  }
} catch (err) {
  console.error(err instanceof Error ? err.message : String(err));
  process.exit(1);
}
JS
}

# The deterministic archive of a working tree, for --worktree: GNU bash, sort and tar in the
# container, the same on every host. It reads the tree read-only at /src and the host's
# `git ls-files -z` lists at /req (all/deleted), and writes /out/worktree.tar. Nested repositories
# are left out; a symbolic link anywhere on a path, any other non-regular file, a `.git` component
# or a path that leaves the tree refuses the whole snapshot. tar never follows links, and the
# archive holds only the regular files listed, with fixed times and owners.
archive_worktree_sh() {
  cat <<'SH'
set -euo pipefail

refuse() { printf 'refusing the working tree: %s\n' "$1" >&2; exit 3; }

declare -A deleted=() checked=()
paths=()
while IFS= read -r -d '' p; do deleted[$p]=1; done < /req/deleted
while IFS= read -r -d '' p; do
  [ -n "${deleted[$p]+x}" ] && continue
  # git lists a nested repository (another clone or worktree inside this one) as `dir/`.
  if [[ $p == */ ]]; then
    printf 'skipping the nested repository %s\n' "$p" >&2
    continue
  fi
  case "/$p/" in
    //* | */../* | */./* | *//*) refuse "path '$p' leaves the tree" ;;
    */.git/*) refuse "path '$p' is inside a .git" ;;
  esac
  prefix=""
  rest=$p
  while [[ $rest == */* ]]; do
    prefix+=${rest%%/*}
    rest=${rest#*/}
    if [ -z "${checked[$prefix]+x}" ]; then
      [ -L "/src/$prefix" ] && refuse "'$prefix' is a symbolic link"
      [ -d "/src/$prefix" ] || refuse "'$prefix' is not a directory"
      checked[$prefix]=1
    fi
    prefix+=/
  done
  [ -L "/src/$p" ] && refuse "'$p' is a symbolic link"
  [ -f "/src/$p" ] || refuse "'$p' is not a regular file"
  paths+=("$p")
done < /req/all
[ ${#paths[@]} -gt 0 ] || refuse "it has no files"

printf '%s\0' "${paths[@]}" | LC_ALL=C sort -z |
  tar -C /src --null --no-recursion --verbatim-files-from -T - -c -f /out/worktree.tar \
    --format=gnu --mtime=@0 --owner=0 --group=0 --numeric-owner
SH
}

# =============================================================================================

# A fork's own settings (docs/sandbox.md), sourced last so that it can override the defaults above.
if [ -f "$SANDBOX_ROOT/dev-sandbox.local" ]; then
  # shellcheck source=/dev/null # a fork's own file
  . "$SANDBOX_ROOT/dev-sandbox.local"
fi

main "$@"; exit
