#!/usr/bin/env bash
# sandbox - run code you did not write, such as someone else's pull request, in a Docker sandbox
# that holds none of your credentials. ./dev-sandbox is `./sandbox dev`. Guide: docs/sandbox.md.
#
# Usage:
#   ./sandbox dev   [TARGET] [--no-open]   start the dev server, print its URL and open a Chromium-family
#                                          browser in a separate profile; reuses a running one
#   ./sandbox dev   [TARGET] --stop        stop that dev server (./dev-sandbox --stop)
#   ./sandbox dev   --status               the same as ./sandbox status (./dev-sandbox --status)
#   ./sandbox test  [TARGET] [-- ARGS]     npm test [-- ARGS]
#   ./sandbox build [TARGET] [-- ARGS]     npm run build [-- ARGS]; prints where dist/ is
#   ./sandbox shell [TARGET] [-- CMD...]   interactive shell (or CMD), no network
#   ./sandbox seed  [TARGET] [--test-cache]  download the game data TARGET needs offline (see Seeds)
#   ./sandbox selftest                     run the isolation self-test on this Docker daemon again
#   ./sandbox status                       dev servers, snapshots, disk use and limits
#   ./sandbox stop  [TARGET | --all]       stop dev servers
#   ./sandbox clean [TARGET | --all]       remove every snapshot and installed dependency set; with
#                                          TARGET only its snapshot; with --all also the seeds,
#                                          caches, browser profile and images
#
# TARGET (default: HEAD of the checkout you are in)
#   COMMIT-ISH    any commit in this repository: committed content only, never the working tree
#   --pr N        pull request N, fetched read-only and without credentials from
#                 https://github.com/scimgg/scimgg.git (or SCIMGG_SANDBOX_UPSTREAM) into refs/sandbox/pr-N
#   --worktree    this checkout's HEAD plus its uncommitted edits, deletions and untracked, non-ignored
#                 files, keyed by a hash of the content; refuses symbolic links
#
# Requirements: bash 3.2+, git 2.31+, curl and Docker Engine 25.0+, on Linux or WSL2 (Docker Engine
#   or Docker Desktop) or macOS (Docker Desktop, OrbStack or Colima). Not native Windows (use WSL2),
#   Podman, or rootless or user-namespace-remapped Docker. Without a working Docker it stops and says
#   what to install or start.
# Isolation self-test: before the first run on a Docker daemon, and again when its ID or version
#   changes, a probe checks that the no-network and internal-network containers reach nothing (no
#   DNS, internet, gateway, host address or host.docker.internal), that the relay still reaches the
#   dev server, and that files written to bind mounts are yours. If a check fails, nothing runs;
#   there is no weaker fallback.
# Seeds: the game cache, item icons and healthbars come from ~/.cache/scimgg-sandbox/seed, mounted
#   read-only. A command that needs one that is missing stops and names it; `./sandbox seed TARGET`
#   downloads what TARGET pins, checking each file against its pin, in a container that runs none of
#   the tree's code.
# Disk: at the start of each command that prepares a snapshot, snapshots unused for
#   SCIMGG_SANDBOX_KEEP_DAYS days (default 7) are removed, and with --worktree those of the tree's
#   earlier content, then the least recently used while
#   snapshots and dependency sets exceed SCIMGG_SANDBOX_MAX_GB (default 5), then dependency sets,
#   images and game caches nothing uses any more. A running sandbox is never touched. A snapshot
#   takes 0.1 to 0.35 GB, a dependency set 0.35 GB, the seeds 0.25 GB and the image 0.7 GB.
# Environment: SCIMGG_SANDBOX_CPUS and SCIMGG_SANDBOX_MEMORY (e.g. 6, 8g; default: Docker's CPUs
#   less headroom, and 3/4 of its memory up to 24g), SCIMGG_SANDBOX_KEEP_DAYS, SCIMGG_SANDBOX_MAX_GB,
#   SCIMGG_SANDBOX_UPSTREAM.
#
# How it isolates (docs/sandbox.md):
#   - The snapshot is `git archive <sha>` under ~/.cache/scimgg-sandbox/: no .git, no history. It and
#     specific read-only seed directories are the only host paths mounted. No $HOME, ~/.ssh,
#     ~/.config, Docker socket or agent socket, and no host environment variable.
#   - Containers run the official node -slim image pinned by digest, plus build tools
#     (scripts/sandbox/Dockerfile), as your non-root uid, with every capability dropped, no-new-privileges, a read-only root, tmpfs /tmp and HOME, and CPU, memory
#     and process limits.
#   - Only `npm ci --ignore-scripts` has network, after a trusted lockfile check, in a directory
#     holding nothing but package.json and package-lock.json. Dependency install scripts, tests,
#     the build, the dev server and the shell run with no network. The dev server sits on an
#     --internal network with no host address; a relay container publishes it on 127.0.0.1 only.
#   - The installed dependencies are shared by every snapshot with the same lockfile, so they are
#     mounted read-only; only Vite's caches inside node_modules are writable, per snapshot.
#   - The other downloads (`./sandbox seed`) run this checkout's own code, never the tree's.
#   - Run it from a checkout you trust: this script, its helpers and the lockfile checker come from
#     the checkout it lives in, never from the snapshot.
#
# What it does not protect against:
#   - A kernel or container-runtime escape. The containers share a kernel with the host or with
#     the Docker VM.
#   - The page's JavaScript, which runs in your browser. That is why it opens a separate profile: no
#     cookies, logins or extensions from your normal one. It can still reach the internet and
#     anything on localhost that the browser can.
#   - Docker itself is root-equivalent on a Linux host; a mistake in these flags is a root mistake.
#   - A snapshot is writable by its own code, so a second run of the same commit sees what the
#     first left behind. `./sandbox clean TARGET` resets it.
# Running the same code directly would give it your credentials, SSH keys and everything else your
# user can reach.
#
# Local extensions: if the checkout this script runs from has scripts/sandbox/local.sh (git-ignored
# here; a fork can commit it), it is sourced at startup as trusted code with your permissions, like
# this script, and never from a snapshot. It lets a fork add its own kind of tree without editing
# the shared files. It may append "MAJOR=IMAGE@sha256:..." words to NODE_IMAGES, add Debian
# packages to SANDBOX_APT_PACKAGES (e.g. a native module's -dev libraries), set SANDBOX_DOCKERFILE
# to its own Dockerfile (ARG NODE_IMAGE and PACKAGES, LABEL scimgg.sandbox=1) or to "" to run the
# pinned image as it is, and define
#   sandbox_local_target   called once per command after TARGET is resolved and before any of its
#                          code runs, with `blob PATH` and `has_blob PATH` reading the target's
#                          committed files as data. It may set:
#     VARIETY                a name for this kind of tree (default: public)
#     NODE_MAJOR             the Node major to run (default: the tree's .nvmrc)
#     SEED_CHECK=(...)       the seed check, run with the command name appended in a no-network
#                            container with the tree read-only at /work; exit 3 means missing
#     SEED_CHECK_ALWAYS=1    also check before dev and build of a prepared snapshot
#     PREPARE_SCRIPT         bash run once, with no network, to prepare a new snapshot
#     BUILD_SCRIPT           bash run by `build`, with the arguments after -- as "$@"
#     SEED_FETCH=(...)       what `./sandbox seed` runs, with network and the tree read-only
#     RUN_FLAGS+=(...)       read-only --mount and -e flags for every container that checks or runs
#                            the snapshot
#     SEED_FLAGS+=(...)      --mount flags for the `./sandbox seed` container
#   Commands in these run in containers, where /sandbox-tools is this checkout's scripts/sandbox/.
#
# Portability: this file must run on macOS's bash 3.2, so no associative arrays, mapfile, ${x,,} or
# |&, every possibly empty array expanded as ${a[@]+"${a[@]}"}, and no GNU-only tools (flock, ss,
# nproc, stat, sha256sum without a fallback, GNU tar options): what needs them runs in a container.

set -euo pipefail

SANDBOX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
STATE="$HOME/.cache/scimgg-sandbox"
UPSTREAM_URL="${SCIMGG_SANDBOX_UPSTREAM:-https://github.com/scimgg/scimgg.git}"

# Official images, pinned by their multi-arch index digest. Taken on 2026-11-27 with
#   docker pull node:24-bookworm-slim && docker image inspect --format '{{index .RepoDigests 0}}' node:24-bookworm-slim
# (Node 24.22.3); refresh it the same way. Snapshots run in an image built on it from
# scripts/sandbox/Dockerfile, which adds SANDBOX_APT_PACKAGES: python3, make and g++ for native
# modules, which build from source because their binary downloads have no network. That is 0.7 GB,
# where the full node image is 1.6 GB.
NODE_IMAGES="24=node@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530"
SANDBOX_DOCKERFILE="$SANDBOX_ROOT/scripts/sandbox/Dockerfile"
SANDBOX_APT_PACKAGES="python3 make g++"
# The image for the self-test, the relay, working-tree archives and seed downloads: the plain base.
TOOLS_IMAGE="node@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530"

# inhibit_ipv4 on internal networks is what keeps the host off them; checked on engines 25.0.5,
# 26.1.4, 27.0.3 and 28.0.4 (docker:*-dind) and used end to end on 29.5.2.
MIN_DOCKER_MAJOR=25
MIN_DOCKER_MINOR=0
SELFTEST_VERSION=1             # bump when probe.mjs or the flags it checks change
SNAPSHOT_FORMAT=2              # bump when a snapshot's layout changes; older ones are removed
TEMPLATE_FORMAT=2              # likewise for dependency sets
PIDS=4096
CHOME=/home/sandbox            # HOME inside the containers (tmpfs)
PORT_BASE=5600                 # away from Vite's default 5173
PORT_SPAN=300
TEMPLATES_KEEP=2               # unused dependency sets kept, for switching between branches
NPM_CACHE_MAX_MB=1024          # the npm download cache is emptied above this

HOST_UID=$(id -u)
HOST_GID=$(id -g)

die() { printf 'sandbox: %s\n' "$1" >&2; exit 1; }
note() { printf '[sandbox] %s\n' "$*" >&2; }

# Things to undo if the script stops early, whatever the reason.
WORKTREE_PARTIAL=""   # a working-tree archive being written
TREE_PARTIAL=""       # a snapshot tree being extracted
TEMPLATE_PARTIAL=""   # a dependency set being installed
SNAP_PARTIAL=""       # a snapshot whose preparation ran the tree's code and has not finished
HOLD=""               # marks the snapshot this run uses, so another run's eviction leaves it
STEP_NAME=""          # the container `step` is waiting for
LOCK_HELD=0
SELFTEST_ACTIVE=0
# shellcheck disable=SC2329 # run by the EXIT trap
cleanup() {
  [ "$SELFTEST_ACTIVE" = 0 ] || selftest_teardown
  [ -z "$WORKTREE_PARTIAL" ] || rm -rf "$WORKTREE_PARTIAL"
  [ -z "$TREE_PARTIAL" ] || remove_tree "$TREE_PARTIAL"
  [ -z "$TEMPLATE_PARTIAL" ] || remove_tree "$TEMPLATE_PARTIAL"
  if [ -n "$SNAP_PARTIAL" ] && [ ! -f "$SNAP_PARTIAL/prepared" ]; then
    remove_tree "$SNAP_PARTIAL"
    note "removed the snapshot whose preparation did not finish"
  fi
  [ -z "$HOLD" ] || rm -f "$HOLD"
  [ "$LOCK_HELD" = 0 ] || rm -rf "$STATE/.lock.d"
}
# shellcheck disable=SC2329 # run by the signal traps
on_signal() {
  trap - INT TERM HUP
  [ -z "$STEP_NAME" ] || docker rm -f "$STEP_NAME" >/dev/null 2>&1 || true
  note "interrupted"
  exit 130
}
trap cleanup EXIT
trap on_signal INT TERM HUP

# Runs `docker run --rm --name NAME ARGS...` in the background and waits for it, so an interrupt
# reaches on_signal at once (bash runs traps only between foreground commands) and removes it.
step() {
  local name=$1 pid rc=0
  shift
  STEP_NAME=$name
  docker run --rm --name "$name" "$@" &
  pid=$!
  wait "$pid" || rc=$?
  STEP_NAME=""
  return "$rc"
}

# The help is the comment block from FROM up to "How it isolates". awk, as BSD and GNU sed disagree
# on brace syntax.
help_text() {
  awk -v from="$1" 'index($0, "# How it isolates") == 1 { exit } index($0, from) == 1 { on = 1 }
    on { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

usage() { help_text "# Usage:"; }

dev_usage() {
  cat <<'EOF'
Usage: ./dev-sandbox [TARGET] [--no-open]   start (or reuse) a sandboxed dev server and open it
       ./dev-sandbox [TARGET] --stop        stop it
       ./dev-sandbox --status               list sandboxes

`npm run dev` for code you did not write: the dev server runs in a credential-free Docker container
with no network, reachable only on 127.0.0.1, and opens in a separate browser profile. It is
`./sandbox dev`; see ./sandbox --help for the other commands.
EOF
  echo ""
  help_text "# TARGET"
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -c1-64
}

# Contents are written by sandboxed code, which may have removed its own write permission. chmod -R
# does not follow symbolic links met during the walk, and rm -rf never does.
remove_tree() {
  [ -e "$1" ] || [ -L "$1" ] || return 0
  chmod -R u+rwX "$1" 2>/dev/null || true
  rm -rf "$1"
}

# Size in KiB of what is under $1, ignoring files sandboxed code made unreadable.
size_kb() { { du -sk "$1" 2>/dev/null || true; } | awk '{ s += $1 } END { print s + 0 }'; }

human_kb() { awk -v k="$1" 'BEGIN { if (k >= 1048576) printf "%.1f GB", k / 1048576; else printf "%d MB", k / 1024 }'; }

# ---------------------------------------------------------------------------------------------
# Host and Docker checks

detect_platform() {
  case "$(uname -s)" in
    Linux)
      PLATFORM=linux
      if [ -r /proc/sys/kernel/osrelease ] && grep -qi microsoft /proc/sys/kernel/osrelease; then PLATFORM=wsl; fi
      ;;
    Darwin) PLATFORM=mac ;;
    MINGW* | MSYS* | CYGWIN*)
      die "native Windows is not supported. Install WSL2 (https://learn.microsoft.com/windows/wsl/install), clone the repository inside it and run ./sandbox there."
      ;;
    *) die "unsupported system '$(uname -s)': ./sandbox runs on Linux, WSL2 and macOS" ;;
  esac
}

docker_install_hint() {
  case "$PLATFORM" in
    mac) echo "Install Docker Desktop (https://docs.docker.com/desktop/setup/install/mac-install/), OrbStack (https://orbstack.dev) or Colima ('brew install colima docker')." ;;
    wsl) echo "Install Docker Engine inside WSL (https://docs.docker.com/engine/install/) or Docker Desktop with WSL integration (https://docs.docker.com/desktop/features/wsl/)." ;;
    *) echo "Install Docker Engine (https://docs.docker.com/engine/install/)." ;;
  esac
}

docker_start_hint() {
  case "$PLATFORM" in
    mac) echo "Start Docker Desktop or OrbStack, or run 'colima start', then try again." ;;
    *) echo "Start it ('sudo systemctl start docker' for Docker Engine, or open Docker Desktop), then try again." ;;
  esac
}

# git 2.31 for `rev-parse --path-format` and `ls-files --deduplicate`; curl for the dev server checks.
preflight_host() {
  local v major minor
  command -v git >/dev/null 2>&1 || die "git is required and not on PATH"
  command -v curl >/dev/null 2>&1 || die "curl is required and not on PATH"
  v=$(git --version | awk '{print $3}')
  major=${v%%.*}
  minor=${v#*.}
  minor=${minor%%.*}
  case "$major.$minor" in *[!0-9.]* | .* | *.) die "cannot read the git version '$v'" ;; esac
  if [ "$major" -lt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -lt 31 ]; }; then
    die "git $v is too old: ./sandbox needs 2.31 or later"
  fi
}

# Stops with what to do unless a supported Docker engine answers. Sets DOCKER_VERSION, DOCKER_ID,
# DOCKER_OS, CPUS and MEMORY.
preflight_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is required, and 'docker' is not on PATH. $(docker_install_hint)"
  local client out major minor rest info ncpu memtotal security mib
  client=$(docker --version 2>/dev/null || true)
  case "$client" in
    *[Pp]odman*) die "'docker' here is Podman ($client). Podman is not supported: the sandbox's isolation is only verified on Docker. $(docker_install_hint)" ;;
  esac
  if ! out=$(docker version --format '{{.Server.Version}}|{{range .Server.Components}}{{.Name}};{{end}}' 2>&1); then
    case "$out" in
      *"ermission denied"*)
        die "Docker is installed, but your user may not use its socket (permission denied). Add yourself to the docker group ('sudo usermod -aG docker \$USER', then log out and back in) or use Docker Desktop. Docker said: $(printf '%s\n' "$out" | tail -n 1)"
        ;;
      *) die "the Docker daemon is not reachable${DOCKER_HOST:+ at DOCKER_HOST=$DOCKER_HOST}. $(docker_start_hint) Docker said: $(printf '%s\n' "$out" | tail -n 1)" ;;
    esac
  fi
  case "$out" in
    *[Pp]odman*) die "the Docker API here is served by Podman. Podman is not supported: the sandbox's isolation is only verified on Docker. $(docker_install_hint)" ;;
  esac
  DOCKER_VERSION=${out%%|*}
  major=${DOCKER_VERSION%%.*}
  rest=${DOCKER_VERSION#*.}
  minor=${rest%%.*}
  case "$major.$minor" in
    *[!0-9.]* | .* | *.) die "cannot read the Docker engine version '$DOCKER_VERSION'" ;;
  esac
  if [ "$major" -lt "$MIN_DOCKER_MAJOR" ] || { [ "$major" -eq "$MIN_DOCKER_MAJOR" ] && [ "$minor" -lt "$MIN_DOCKER_MINOR" ]; }; then
    die "Docker Engine $DOCKER_VERSION is too old: ./sandbox needs $MIN_DOCKER_MAJOR.$MIN_DOCKER_MINOR or later, for internal networks that give the host no address (com.docker.network.bridge.inhibit_ipv4). Update Docker and try again."
  fi
  info=$(docker info --format '{{.ID}}|{{.NCPU}}|{{.MemTotal}}|{{.OperatingSystem}}|{{.SecurityOptions}}' 2>&1) ||
    die "docker info failed: $info"
  DOCKER_ID=${info%%|*}; info=${info#*|}
  ncpu=${info%%|*}; info=${info#*|}
  memtotal=${info%%|*}; info=${info#*|}
  DOCKER_OS=${info%%|*}
  security=${info#*|}
  case "$security" in
    *rootless* | *userns*)
      die "rootless or user-namespace-remapped Docker is not supported: there the sandbox's non-root container user does not map to you, so it cannot use the snapshot it is given, and the fix (running as root inside the container) is a weaker contract. Use rootful Docker Engine or Docker Desktop."
      ;;
  esac

  if [ -n "${SCIMGG_SANDBOX_CPUS:-}" ]; then
    [[ $SCIMGG_SANDBOX_CPUS =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "SCIMGG_SANDBOX_CPUS must be a number of CPUs, such as 4 or 2.5"
    [ "${SCIMGG_SANDBOX_CPUS%%.*}" -lt "$ncpu" ] || [ "$SCIMGG_SANDBOX_CPUS" = "$ncpu" ] ||
      die "SCIMGG_SANDBOX_CPUS=$SCIMGG_SANDBOX_CPUS is more than the $ncpu CPUs Docker has"
    CPUS=$SCIMGG_SANDBOX_CPUS
  elif [ "$ncpu" -ge 4 ]; then
    CPUS=$((ncpu - 2))
  elif [ "$ncpu" -ge 2 ]; then
    CPUS=$((ncpu - 1))
  else
    CPUS=1
  fi
  if [ -n "${SCIMGG_SANDBOX_MEMORY:-}" ]; then
    [[ $SCIMGG_SANDBOX_MEMORY =~ ^[1-9][0-9]*[mMgG]$ ]] || die "SCIMGG_SANDBOX_MEMORY must be like 8g or 6144m"
    MEMORY=$SCIMGG_SANDBOX_MEMORY
  else
    mib=$((memtotal * 3 / 4 / 1048576))
    [ "$mib" -le 24576 ] || mib=24576
    MEMORY="${mib}m"
    [ "$mib" -ge 6144 ] || note "Docker has $((memtotal / 1048576)) MiB of memory, so containers get ${mib} MiB; the full test suite may need more (give Docker more memory, or set SCIMGG_SANDBOX_MEMORY)"
  fi
}

read_limits() {
  KEEP_DAYS=${SCIMGG_SANDBOX_KEEP_DAYS:-7}
  MAX_GB=${SCIMGG_SANDBOX_MAX_GB:-5}
  [[ $KEEP_DAYS =~ ^[0-9]+$ ]] || die "SCIMGG_SANDBOX_KEEP_DAYS must be a whole number of days, such as 7"
  [[ $MAX_GB =~ ^[0-9]+$ ]] || die "SCIMGG_SANDBOX_MAX_GB must be a whole number of GB, such as 5"
}

# A passwd and group that know your uid and gid, so tools that look the user up work for any uid
# (macOS users are 501, the image only knows 1000).
ensure_identity() {
  mkdir -p "$STATE/etc"
  printf 'root:x:0:0:root:/root:/usr/sbin/nologin\nsandbox:x:%s:%s:sandbox:%s:/bin/bash\nnobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin\n' \
    "$HOST_UID" "$HOST_GID" "$CHOME" > "$STATE/etc/passwd"
  printf 'root:x:0:\nsandbox:x:%s:\nnogroup:x:65534:\n' "$HOST_GID" > "$STATE/etc/group"
}

# One run prepares or evicts at a time. mkdir is atomic everywhere; a lock whose owner has gone is
# taken over.
acquire_lock() {
  local lock="$STATE/.lock.d" pid waited=0
  mkdir -p "$STATE"
  until mkdir "$lock" 2>/dev/null; do
    pid=$(cat "$lock/pid" 2>/dev/null || true)
    if { [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; } || { [ -z "$pid" ] && [ "$waited" -ge 10 ]; }; then
      note "taking over a lock left by a run that is gone (${pid:-no pid})"
      rm -rf "$lock"
      continue
    fi
    [ "$waited" -ne 0 ] || note "waiting for another ./sandbox run (process ${pid:-?}) to finish preparing"
    sleep 1
    waited=$((waited + 1))
  done
  echo "$$" > "$lock/pid"
  LOCK_HELD=1
}

release_lock() {
  rm -rf "$STATE/.lock.d"
  LOCK_HELD=0
}

# Pulls an image by digest unless Docker has it, and records that this script pulled it, so
# eviction may later remove that reference (and only that one) once nothing pins it.
ensure_pulled() {
  docker image inspect "$1" >/dev/null 2>&1 && return 0
  note "pulling $1 (once)"
  docker pull --quiet "$1" >/dev/null || die "could not pull $1"
  mkdir -p "$STATE"
  echo "$1" >> "$STATE/pulled-images"
}

# ---------------------------------------------------------------------------------------------
# Targets

REPO=""            # git repository the commit is archived from
SHA=""             # full commit SHA (for a working tree, its HEAD)
ID=""              # what the snapshot is keyed by: SHA, or for a working tree SHA-worktree-<content hash>
WORKTREE_TAR=""    # for a working tree: its archive, the only source the host reads files from
SOURCE=""          # human description

current_repo() {
  git rev-parse --show-toplevel 2>/dev/null || git -C "$SANDBOX_ROOT" rev-parse --show-toplevel
}

# Fetches pull request N into refs/sandbox/pr-N, or with `local`, uses the ref already there (to
# stop or clean what an earlier run started, even if the pull request has moved since).
fetch_pr() {
  local n=$1 mode=${2:-fetch}
  [[ $n =~ ^[1-9][0-9]*$ ]] || die "--pr needs a pull request number, not '$n'"
  REPO=$(current_repo)
  SOURCE="pull request #$n"
  if [ "$mode" = local ]; then
    SHA=$(git -C "$REPO" rev-parse --verify --quiet "refs/sandbox/pr-$n^{commit}") || die "pull request $n was never fetched here"
    return
  fi
  case "$UPSTREAM_URL" in https://*) ;; *) die "SCIMGG_SANDBOX_UPSTREAM must be an https:// URL" ;; esac
  note "fetching pull request $n from $UPSTREAM_URL (read-only, no credentials)"
  # No credential helper, prompt or extra header, and https only, so a URL rewrite in your git
  # config cannot turn this into an SSH fetch with your keys.
  GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false \
    git -C "$REPO" -c credential.helper= -c credential.https://github.com.helper= \
      -c http.extraHeader= -c http.https://github.com/.extraHeader= -c core.askPass=/bin/false \
      -c protocol.allow=never -c protocol.https.allow=always -c fetch.fsckObjects=true \
      fetch --quiet --no-tags --no-write-fetch-head "$UPSTREAM_URL" "+pull/$n/head:refs/sandbox/pr-$n" ||
    die "could not fetch pull request $n from $UPSTREAM_URL"
  SHA=$(git -C "$REPO" rev-parse --verify "refs/sandbox/pr-$n^{commit}")
}

# The working tree as one deterministic tar, built by scripts/sandbox/archive-worktree.sh in a
# no-network container (GNU tools on every host) from the paths git lists here. It refuses
# symbolic links, non-regular files, `.git` components and paths that leave the tree.
archive_worktree() {
  local dir=$1 out=$2 rc=0
  git -C "$dir" ls-files -z --deleted > "$out/deleted"
  git -C "$dir" ls-files -z --cached --others --exclude-standard --deduplicate > "$out/all"
  base_flags none
  step "scimgg-sandbox-archive-$$" "${FLAGS[@]}" \
    --mount "$(ro "$dir" /src)" --mount "$(ro "$out" /req)" --mount "$(rw "$out" /out)" \
    --mount "$(ro "$SANDBOX_ROOT/scripts/sandbox/archive-worktree.sh" /archive-worktree.sh)" \
    "$TOOLS_IMAGE" bash /archive-worktree.sh || rc=$?
  [ "$rc" -eq 0 ] || die "could not snapshot $dir (see above); nothing was run"
}

resolve_target() {
  local kind=$1 spec=$2 mode=${3:-fetch}
  KIND=$kind
  case "$kind" in
    pr) fetch_pr "$spec" "$mode" ;;
    worktree)
      REPO=$(current_repo)
      SHA=$(git -C "$REPO" rev-parse --verify 'HEAD^{commit}')
      SOURCE="$REPO working tree"
      # Stopping or cleaning works on whatever this tree started, so it needs no new archive.
      [ "$mode" = local ] && return 0
      mkdir -p "$STATE/tmp"
      local work hash
      work=$(mktemp -d "$STATE/tmp/worktree.XXXXXX")
      WORKTREE_PARTIAL=$work
      archive_worktree "$REPO" "$work"
      WORKTREE_TAR="$work/worktree.tar"
      hash=$(sha256 < "$WORKTREE_TAR" | cut -c1-16)
      ID="$SHA-worktree-$hash"
      SHORT="${SHA:0:7}-w$hash"
      SHORT=${SHORT:0:16}
      note "$SOURCE: HEAD $SHA plus these changes (content $hash):"
      GIT_OPTIONAL_LOCKS=0 git -C "$REPO" status --short --untracked-files=all | sed 's/^/    /' >&2
      ;;
    commit)
      REPO=$(current_repo)
      SHA=$(git -C "$REPO" rev-parse --verify --quiet "$spec^{commit}") || die "no commit '$spec' in $REPO"
      SOURCE="$spec"
      if [ "$spec" = HEAD ] && [ -n "$(git -C "$REPO" status --porcelain --untracked-files=no)" ]; then
        note "the working tree has uncommitted changes; they are not included (--worktree includes them)"
      fi
      ;;
  esac
  if [ -z "$WORKTREE_TAR" ]; then
    ID=$SHA
    SHORT=${SHA:0:12}
  fi
  SNAP="$STATE/snapshots/$ID"
  TREE="$SNAP/tree"
  APP="scimgg-sandbox-dev-$SHORT"
  PROXY="scimgg-sandbox-proxy-$SHORT"
  NET="scimgg-sandbox-net-$SHORT"
}

# A file of the snapshot as git stores it (or as the working-tree archive holds it), never read
# through the extracted tree, which sandboxed code can change.
blob() {
  if [ -n "$WORKTREE_TAR" ]; then tar -xOf "$WORKTREE_TAR" "$1"; else git -C "$REPO" show "$SHA:$1"; fi
}
has_blob() {
  if [ -n "$WORKTREE_TAR" ]; then
    tar -tf "$WORKTREE_TAR" "$1" >/dev/null 2>&1
  else
    git -C "$REPO" cat-file -e "$SHA:$1" 2>/dev/null
  fi
}

regular_blob() {
  local mode
  if [ -n "$WORKTREE_TAR" ]; then
    # The working-tree archive holds regular files only.
    has_blob "$1" || die "$1 is missing from $SOURCE"
    return 0
  fi
  mode=$(git -C "$REPO" ls-tree "$SHA" -- "$1" | cut -d' ' -f1)
  [ "$mode" = 100644 ] || [ "$mode" = 100755 ] || die "$1 in $SHORT is missing or not a regular file"
}

# What kind of tree this is and how to run it: a tree of this repository by default, or whatever
# scripts/sandbox/local.sh decides (see "Local extensions" above).
target_settings() {
  VARIETY=public
  NODE_MAJOR=""
  SEED_CHECK=(node /sandbox-tools/seed.mjs check)
  SEED_CHECK_ALWAYS=0
  PREPARE_SCRIPT='node /sandbox-tools/seed.mjs assets && npm run setup -- --offline'
  # shellcheck disable=SC2016 # expanded by the container's bash
  BUILD_SCRIPT='npm run build -- "$@"'
  SEED_FETCH=(node /sandbox-tools/fetch-seeds.mjs)
  RUN_FLAGS=()
  SEED_FLAGS=()
  if declare -F sandbox_local_target >/dev/null; then sandbox_local_target; fi
  return 0
}

pick_image() {
  local major=$NODE_MAJOR word pinned=""
  if [ -z "$major" ] && has_blob .nvmrc; then
    major=$(blob .nvmrc | tr -d '[:space:]v' | cut -d. -f1)
  fi
  [ -n "$major" ] || die "$SOURCE has no .nvmrc naming the Node version to run"
  BASE_IMAGE=""
  for word in $NODE_IMAGES; do
    pinned="$pinned ${word%%=*}"
    [ "${word%%=*}" != "$major" ] || BASE_IMAGE=${word#*=}
  done
  [ -n "$BASE_IMAGE" ] || die "$SOURCE asks for Node '$major'; ./sandbox pins an image for Node$pinned only (NODE_IMAGES)"
  NODE_MAJOR=$major
  ensure_pulled "$BASE_IMAGE"
  if [ -z "$SANDBOX_DOCKERFILE" ]; then
    IMAGE=$BASE_IMAGE
    return 0
  fi
  # A local image built on the pinned one, tagged by what it is built from, so a change to any of
  # it makes a new tag and eviction removes the old one. Built once, from that file alone (an
  # empty context); no snapshot is involved. apt-get fetches the packages from Debian's mirrors.
  IMAGE=$(built_image_tag "$major" "$BASE_IMAGE")
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    note "building $IMAGE: $BASE_IMAGE plus $SANDBOX_APT_PACKAGES (once)"
    docker build --quiet --label scimgg.sandbox=1 --build-arg "NODE_IMAGE=$BASE_IMAGE" \
      --build-arg "PACKAGES=$SANDBOX_APT_PACKAGES" -t "$IMAGE" - < "$SANDBOX_DOCKERFILE" >/dev/null ||
      die "could not build $IMAGE"
  fi
}

built_image_tag() {
  printf 'scimgg-sandbox-node:%s-%s' "$1" \
    "$( { cat "$SANDBOX_DOCKERFILE"; echo "$2"; echo "$SANDBOX_APT_PACKAGES"; } | sha256 | cut -c1-12)"
}

# ---------------------------------------------------------------------------------------------
# Containers

# Flags every sandbox container shares. Nothing from the host environment is passed: only the
# variables listed here and in each caller.
base_flags() {
  local net=$1
  FLAGS=(
    --init
    --network "$net"
    --user "$HOST_UID:$HOST_GID"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --read-only
    --tmpfs "/tmp:rw,nosuid,nodev,exec,size=4g"
    --tmpfs "$CHOME:rw,nosuid,nodev,noexec,size=512m,uid=$HOST_UID,gid=$HOST_GID,mode=0700"
    --tmpfs "$CHOME/.cache:rw,nosuid,nodev,noexec,size=512m,uid=$HOST_UID,gid=$HOST_GID,mode=0700"
    --mount "type=bind,src=$STATE/etc/passwd,dst=/etc/passwd,readonly"
    --mount "type=bind,src=$STATE/etc/group,dst=/etc/group,readonly"
    --pids-limit "$PIDS"
    --memory "$MEMORY" --memory-swap "$MEMORY"
    --cpus "$CPUS"
    --hostname scimgg-sandbox
    --label scimgg.sandbox=1
    -e HOME="$CHOME"
    -e npm_config_update_notifier=false
    -e npm_config_fund=false
    -e npm_config_audit=false
    -e PUPPETEER_SKIP_DOWNLOAD=1
  )
  if [ "$net" = none ]; then
    FLAGS+=(-e npm_config_offline=true -e npm_config_cache=/tmp/npm-cache)
  fi
}

ro() { printf 'type=bind,src=%s,dst=%s,readonly' "$1" "$2"; }
rw() { printf 'type=bind,src=%s,dst=%s' "$1" "$2"; }

main_checkout() {
  cd "$(git -C "$SANDBOX_ROOT" rev-parse --path-format=absolute --git-common-dir)/.." && pwd -P
}

# The golden real-cache test fixture: a checkout's .test-cache/ (where the tests look by default),
# or the one `./sandbox seed --test-cache` saved.
test_cache_dir() {
  local dir
  for dir in "$(current_repo)" "$(main_checkout)"; do
    if [ -f "$dir/.test-cache/disk.zip" ]; then echo "$dir/.test-cache"; return 0; fi
  done
  if [ -f "$STATE/seed/test-cache/disk.zip" ]; then echo "$STATE/seed/test-cache"; fi
}

# Read-only seed data and helpers for every container that checks or runs the snapshot.
TEST_NOTE_SHOWN=0
run_flags() {
  local test_cache
  mkdir -p "$STATE/seed"
  RUNF=(--mount "$(ro "$STATE/seed" /seed)" --mount "$(ro "$SANDBOX_ROOT/scripts/sandbox" /sandbox-tools)")
  test_cache=$(test_cache_dir)
  if [ -n "$test_cache" ]; then
    RUNF+=(--mount "$(ro "$test_cache" /seed-test-cache)" -e SCIM_REAL_CACHE_PATH=/seed-test-cache/disk.zip)
  elif [ "$CMD" = test ] && [ "$TEST_NOTE_SHOWN" = 0 ]; then
    note "no golden test cache (.test-cache/disk.zip): the real-cache suites skip. ./sandbox seed ${TARGET_ARGS:+$TARGET_ARGS }--test-cache fetches it (160 MB)."
    TEST_NOTE_SHOWN=1
  fi
  RUNF+=(${RUN_FLAGS[@]+"${RUN_FLAGS[@]}"})
}

# The snapshot at /work, with the shared dependency set read-only at /work/node_modules and only
# Vite's caches in it writable: .vite (dependency pre-bundles and Vitest's results) per snapshot,
# .vite-temp (the bundled config) and .cache in memory. The mount points exist in the set.
tree_flags() {
  [ -d "$TREE/node_modules" ] && [ ! -L "$TREE/node_modules" ] || die "$TREE/node_modules is not the directory this script made; ./sandbox clean ${TARGET_ARGS:-HEAD} resets the snapshot"
  TREEF=(
    --mount "$(rw "$TREE" /work)"
    --mount "$(ro "$TEMPLATE/node_modules" /work/node_modules)"
    --mount "$(rw "$SNAP/vite" /work/node_modules/.vite)"
    --tmpfs "/work/node_modules/.vite-temp:rw,nosuid,nodev,size=256m,uid=$HOST_UID,gid=$HOST_GID"
    --tmpfs "/work/node_modules/.cache:rw,nosuid,nodev,size=1g,uid=$HOST_UID,gid=$HOST_GID"
    --label "scimgg.sandbox.sha=$ID"
    -w /work
  )
}

tty_flags() {
  TTY=()
  if [ -t 0 ] && [ -t 1 ]; then TTY=(-it -e TERM=xterm-256color); fi
}

# ---------------------------------------------------------------------------------------------
# Isolation self-test (scripts/sandbox/probe.mjs)

SELFTEST_NET=scimgg-sandbox-net-selftest
SELFTEST_PROBE=scimgg-sandbox-selftest-probe
SELFTEST_RELAY=scimgg-sandbox-proxy-selftest
SELFTEST_DIR=""

selftest_teardown() {
  docker rm -f "$SELFTEST_PROBE" "$SELFTEST_RELAY" scimgg-sandbox-selftest-none >/dev/null 2>&1 || true
  docker network rm "$SELFTEST_NET" >/dev/null 2>&1 || true
  [ -z "$SELFTEST_DIR" ] || rm -rf "$SELFTEST_DIR"
  SELFTEST_ACTIVE=0
}

# Addresses the dev server must not reach: every Docker network's gateway, the host's own
# addresses, and Docker Desktop's host-side addresses.
selftest_candidates() {
  # shellcheck disable=SC2046 # network ids are hex words
  docker network inspect --format '{{range .IPAM.Config}}{{.Gateway}} {{end}}' $(docker network ls -q) 2>/dev/null | tr ' ' '\n'
  if command -v ip >/dev/null 2>&1; then
    ip -o -4 addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1
  elif command -v ifconfig >/dev/null 2>&1; then
    ifconfig 2>/dev/null | awk '$1 == "inet" {print $2}' | sed 's/^addr://'
  fi
  printf '%s\n' 192.168.65.1 192.168.65.254
}

selftest() {
  local force=${1:-0} key marker log out rc relay_ip status candidates=() a
  key=$(printf '%s|%s|%s|%s\n' "$DOCKER_ID" "$DOCKER_VERSION" "$SELFTEST_VERSION" "$TOOLS_IMAGE" | sha256 | cut -c1-16)
  marker="$STATE/selftest/$key.ok"
  if [ "$force" = 0 ] && [ -z "${SCIMGG_SANDBOX_SELFTEST_EXTRA:-}" ] && [ -f "$marker" ]; then return 0; fi
  ensure_pulled "$TOOLS_IMAGE"
  note "isolation self-test on this Docker daemon (Docker $DOCKER_VERSION, $DOCKER_OS)"
  mkdir -p "$STATE/selftest"
  log="$STATE/selftest/last.log"
  SELFTEST_ACTIVE=1
  selftest_teardown
  SELFTEST_ACTIVE=1
  SELFTEST_DIR=$(mktemp -d "$STATE/selftest/rw.XXXXXX")
  : > "$log"
  status=0

  # A --network none phase, and the ownership of what it writes into a bind mount.
  base_flags none
  rc=0
  out=$(docker run --rm "${FLAGS[@]}" --name scimgg-sandbox-selftest-none \
    --mount "$(ro "$SANDBOX_ROOT/scripts/sandbox" /sandbox-tools)" --mount "$(rw "$SELFTEST_DIR" /rw)" \
    "$TOOLS_IMAGE" node /sandbox-tools/probe.mjs none /rw/owner 2>&1) || rc=$?
  printf '[no network]\n%s\n' "$out" >> "$log"
  { [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qx 'done 0'; } || status=1
  if [ ! -f "$SELFTEST_DIR/owner" ] || [ ! -O "$SELFTEST_DIR/owner" ]; then
    echo "FAIL a file the container wrote into a bind mount is not owned by you" >> "$log"
    status=1
  fi

  # The dev server's internal network, reached only through the relay.
  docker network create --internal -o com.docker.network.bridge.inhibit_ipv4=true \
    --label scimgg.sandbox=1 "$SELFTEST_NET" >/dev/null
  start_relay "$SELFTEST_RELAY" "$SELFTEST_PROBE" "$SELFTEST_NET" "$PORT_BASE"
  relay_ip=$(docker inspect -f "{{(index .NetworkSettings.Networks \"$SELFTEST_NET\").IPAddress}}" "$SELFTEST_RELAY")
  while IFS= read -r a; do
    [ -n "$a" ] && candidates+=("$a")
  done < <(selftest_candidates | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^127\.' | sort -u)
  # A test hook: extra addresses that must be unreachable, or `self`, which never is, to check that
  # a failure stops everything. It never records a pass.
  # shellcheck disable=SC2206 # deliberately split: a list of addresses, or `self`
  [ -z "${SCIMGG_SANDBOX_SELFTEST_EXTRA:-}" ] || candidates+=($SCIMGG_SANDBOX_SELFTEST_EXTRA)
  base_flags "$SELFTEST_NET"
  docker run -d "${FLAGS[@]}" --name "$SELFTEST_PROBE" \
    --mount "$(ro "$SANDBOX_ROOT/scripts/sandbox" /sandbox-tools)" \
    "$TOOLS_IMAGE" node /sandbox-tools/probe.mjs internal "$RELAY_PORT" "!$relay_ip" \
    ${candidates[@]+"${candidates[@]}"} >/dev/null
  local i=0
  while :; do
    out=$(docker logs "$SELFTEST_PROBE" 2>&1 || true)
    case "$out" in *"done "*) break ;; esac
    i=$((i + 1))
    if [ "$i" -gt 60 ] || ! running "$SELFTEST_PROBE"; then break; fi
    sleep 0.5
  done
  printf '[internal network]\n%s\n' "$out" >> "$log"
  printf '%s\n' "$out" | grep -qx 'done 0' || status=1
  i=0
  while :; do
    out=$(curl --connect-timeout 2 --max-time 3 -fsS "http://127.0.0.1:$RELAY_PORT/" 2>/dev/null || true)
    case "$out" in scimgg-sandbox-probe*) break ;; esac
    i=$((i + 1))
    if [ "$i" -gt 10 ]; then
      echo "FAIL the relay on 127.0.0.1:$RELAY_PORT does not reach the internal network" >> "$log"
      status=1
      break
    fi
    sleep 0.5
  done
  [ "$status" -ne 0 ] || echo "ok   the relay on 127.0.0.1:$RELAY_PORT reaches the internal network" >> "$log"
  selftest_teardown

  if [ "$status" -ne 0 ]; then
    rm -f "$marker"
    grep -E '^(FAIL|\[)' "$log" >&2 || true
    die "the isolation self-test failed on this Docker daemon (full report: $log). The sandbox does not run where its isolation does not hold, and has no weaker mode. Report the lines above with 'docker version' and 'docker info'."
  fi
  note "self-test passed: $(grep -c '^ok' "$log") checks (report: $log)"
  [ -n "${SCIMGG_SANDBOX_SELFTEST_EXTRA:-}" ] || touch "$marker"
}

# ---------------------------------------------------------------------------------------------
# Disk: eviction and status

# Whether snapshot ID must stay: the current target, any sandbox container's (running or not), or
# one a live run holds.
snap_protected() {
  local id=$1 hold pid
  case "$PROTECTED" in *"|$id|"*) return 0 ;; esac
  for hold in "$STATE/snapshots/$id"/hold.*; do
    [ -e "$hold" ] || continue
    pid=${hold##*.}
    if kill -0 "$pid" 2>/dev/null; then return 0; fi
    rm -f "$hold"
  done
  return 1
}

snap_kb() {
  if [ ! -f "$1/size" ]; then size_kb "$1" > "$1/size"; fi
  cat "$1/size"
}

record_size() { size_kb "$SNAP" > "$SNAP/size" 2>/dev/null || true; }

EVICTED_KB=0
EVICTED=""
evicted() {
  EVICTED_KB=$((EVICTED_KB + $2))
  EVICTED="$EVICTED${EVICTED:+, }$1"
}

# Runs with the lock held, before the current target is prepared.
evict() {
  local snap id kb total=0 n=0 key refs="|" t hold_t=0 removed_tpl=0 max_kb=$((MAX_GB * 1048576)) fresh current
  current=$(current_images)
  local oldest=()
  EVICTED_KB=0
  EVICTED=""
  PROTECTED="|$ID|$(docker ps -a --filter label=scimgg.sandbox=1 --format '{{.Label "scimgg.sandbox.sha"}}' | tr '\n' '|')"
  mkdir -p "$STATE/snapshots" "$STATE/node-modules"

  # Snapshots of an older layout, or unused for KEEP_DAYS.
  for snap in "$STATE"/snapshots/*/; do
    [ -d "$snap" ] || continue
    snap=${snap%/}
    id=${snap##*/}
    snap_protected "$id" && continue
    if [ "$(cat "$snap/format" 2>/dev/null)" != "$SNAPSHOT_FORMAT" ] || [ "$KEEP_DAYS" = 0 ] ||
      [ -n "$(find "$snap/used" -mmin +$((KEEP_DAYS * 1440)) 2>/dev/null)" ]; then
      kb=$(snap_kb "$snap")
      remove_tree "$snap"
      n=$((n + 1))
      EVICTED_KB=$((EVICTED_KB + kb))
    fi
  done
  [ "$n" = 0 ] || evicted "$n unused snapshot(s)" 0

  # A working tree's snapshots of its earlier content, which an edit has replaced.
  n=0
  if [ "$KIND" = worktree ]; then
    for snap in "$STATE"/snapshots/*-worktree-*/; do
      [ -d "$snap" ] || continue
      snap=${snap%/}
      id=${snap##*/}
      [ "$(cat "$snap/source" 2>/dev/null)" = "$SOURCE" ] || continue
      snap_protected "$id" && continue
      kb=$(snap_kb "$snap")
      remove_tree "$snap"
      n=$((n + 1))
      EVICTED_KB=$((EVICTED_KB + kb))
    done
  fi
  [ "$n" = 0 ] || evicted "$n snapshot(s) of this working tree's earlier content" 0

  # Then the least recently used while snapshots and dependency sets exceed MAX_GB.
  for snap in "$STATE"/snapshots/*/; do
    [ -d "$snap" ] && total=$((total + $(snap_kb "${snap%/}")))
  done
  for t in "$STATE"/node-modules/*/size; do
    [ -f "$t" ] && total=$((total + $(cat "$t")))
  done
  n=0
  if [ "$total" -gt "$max_kb" ]; then
    while IFS= read -r t; do
      [ -n "$t" ] && oldest+=("${t%/used}")
    done < <(ls -1tr "$STATE"/snapshots/*/used 2>/dev/null || true)
    for snap in ${oldest[@]+"${oldest[@]}"}; do
      [ "$total" -gt "$max_kb" ] || break
      snap_protected "${snap##*/}" && continue
      kb=$(snap_kb "$snap")
      remove_tree "$snap"
      total=$((total - kb))
      n=$((n + 1))
      EVICTED_KB=$((EVICTED_KB + kb))
    done
  fi
  [ "$n" = 0 ] || evicted "$n least recently used snapshot(s) (over $MAX_GB GB)" 0

  # Dependency sets no snapshot uses, except the most recent few unless still over the limit.
  # Unfinished ones whose run has gone are removed too.
  for t in "$STATE"/node-modules/*.partial.*; do
    [ -e "$t" ] || continue
    kill -0 "${t##*.}" 2>/dev/null || remove_tree "$t"
  done
  for t in "$STATE"/snapshots/*/template; do
    [ -f "$t" ] && refs="$refs$(cat "$t")|"
  done
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    key=${t%/used}
    key=${key##*/}
    case "$refs" in *"|$key|"*) continue ;; esac
    [ "$key" != "${TEMPLATE_KEY:-}" ] || continue
    # Kept for a later run only if built for an image this checkout would still use.
    case "$current" in *"|$(cat "$STATE/node-modules/$key/image" 2>/dev/null)|"*) fresh=1 ;; *) fresh=0 ;; esac
    if [ "$fresh" = 1 ] && [ "$hold_t" -lt "$TEMPLATES_KEEP" ] && [ "$total" -le "$max_kb" ]; then
      hold_t=$((hold_t + 1))
      continue
    fi
    kb=$(cat "$STATE/node-modules/$key/size" 2>/dev/null || echo 0)
    remove_tree "$STATE/node-modules/$key"
    total=$((total - kb))
    removed_tpl=$((removed_tpl + 1))
    EVICTED_KB=$((EVICTED_KB + kb))
  done < <(ls -1t "$STATE"/node-modules/*/used 2>/dev/null || true)
  # Sets of an older layout have no `used` file.
  for t in "$STATE"/node-modules/*/; do
    [ -d "$t" ] || continue
    t=${t%/}
    case "$t" in *.partial.*) continue ;; esac
    if [ "$(cat "$t/format" 2>/dev/null)" != "$TEMPLATE_FORMAT" ]; then
      kb=$(size_kb "$t")
      remove_tree "$t"
      rm -f "$t.ready"
      removed_tpl=$((removed_tpl + 1))
      EVICTED_KB=$((EVICTED_KB + kb))
    fi
  done
  [ "$removed_tpl" = 0 ] || evicted "$removed_tpl unused dependency set(s)" 0

  evict_images
  evict_seed_caches

  # Leftovers of interrupted runs: working-tree archives and self-test directories over a day old.
  find "$STATE/tmp" "$STATE/selftest" -mindepth 1 -maxdepth 1 \( -name 'worktree.*' -o -name 'rw.*' \) \
    -mmin +1440 -exec rm -rf {} + 2>/dev/null || true

  [ -z "$EVICTED" ] || note "freed $(human_kb "$EVICTED_KB"): removed $EVICTED (see ./sandbox status)"
}

# "|image|image|...": the images this checkout runs: each pinned one, what it builds from it, and
# the tools image.
current_images() {
  local images="|${IMAGE:-}|$TOOLS_IMAGE|" word
  for word in $NODE_IMAGES; do
    images="$images${word#*=}|"
    [ -z "$SANDBOX_DOCKERFILE" ] || images="$images$(built_image_tag "${word%%=*}" "${word#*=}")|"
  done
  printf '%s' "$images"
}

# This script's own images once nothing pins them: tags it built (scimgg-sandbox-node), and image
# references it pulled itself (listed in pulled-images). Never other images, and never build cache.
evict_images() {
  local keep t ref n=0 left=""
  keep=$(current_images)
  for t in "$STATE"/node-modules/*/image; do
    [ -f "$t" ] && keep="$keep$(cat "$t")|"
  done
  while IFS= read -r ref; do
    case "$ref" in scimgg-sandbox-node:*) ;; *) continue ;; esac
    case "$keep" in *"|$ref|"*) continue ;; esac
    if docker image rm "$ref" >/dev/null 2>&1; then n=$((n + 1)); fi
  done < <(docker image ls --filter label=scimgg.sandbox=1 --format '{{.Repository}}:{{.Tag}}' 2>/dev/null || true)
  if [ -f "$STATE/pulled-images" ]; then
    while IFS= read -r ref; do
      [ -n "$ref" ] || continue
      case "$left" in *"|$ref|"*) continue ;; esac
      case "$keep" in
        *"|$ref|"*) left="$left|$ref|" ;;
        *)
          if docker image rm "$ref" >/dev/null 2>&1; then n=$((n + 1))
          elif docker image inspect "$ref" >/dev/null 2>&1; then left="$left|$ref|"   # in use
          fi
          ;;
      esac
    done < "$STATE/pulled-images"
    printf '%s' "$left" | tr '|' '\n' | grep -v '^$' > "$STATE/pulled-images.new" || true
    mv "$STATE/pulled-images.new" "$STATE/pulled-images"
  fi
  [ "$n" = 0 ] || evicted "$n unused image(s)" 0
}

# Game caches no remaining snapshot links (a public tree's .setup-cache/ names its pinned cache),
# except the newest, which the next commit most likely pins too. Item icons and healthbars are
# small (about 25 MB, growing only when RuneLite re-renders one) and stay until `clean --all`.
evict_seed_caches() {
  local refs="|" f id n=0 kb first=1
  for f in "$STATE"/snapshots/*/tree/.setup-cache/openrs2-*-disk.zip; do
    [ -L "$f" ] || [ -e "$f" ] || continue
    id=${f##*/openrs2-}
    refs="$refs${id%-disk.zip}|"
  done
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ "$first" = 1 ]; then first=0; continue; fi
    id=${f##*/}
    case "$refs" in *"|${id%-disk.zip}|"*) continue ;; esac
    kb=$(size_kb "$f")
    rm -f "$f"
    n=$((n + 1))
    EVICTED_KB=$((EVICTED_KB + kb))
  done < <(ls -1t "$STATE"/seed/cache/*-disk.zip 2>/dev/null || true)
  [ "$n" = 0 ] || evicted "$n unused game cache(s)" 0
}

disk_report() {
  local n_snap=0 snap_kb_total=0 n_tpl=0 tpl_kb=0 snap t ref word images listing image_lines n_img=0 size id
  for snap in "$STATE"/snapshots/*/; do
    [ -d "$snap" ] || continue
    n_snap=$((n_snap + 1))
    snap_kb_total=$((snap_kb_total + $(snap_kb "${snap%/}")))
  done
  for t in "$STATE"/node-modules/*/; do
    [ -d "$t" ] || continue
    n_tpl=$((n_tpl + 1))
    tpl_kb=$((tpl_kb + $(cat "${t%/}/size" 2>/dev/null || size_kb "$t")))
  done
  # The pinned images, the ones this script built, and any it pulled that eviction has not yet
  # removed, with Docker's own size figures.
  images=$( {
    for word in $NODE_IMAGES; do echo "${word#*=}"; done
    echo "$TOOLS_IMAGE"
    docker image ls --filter label=scimgg.sandbox=1 --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep '^scimgg-sandbox-node:' || true
    cat "$STATE/pulled-images" 2>/dev/null || true
  } | sort -u)
  listing=$(docker image ls --no-trunc --format '{{.ID}}|{{.Size}}' 2>/dev/null || true)
  image_lines=""
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    id=$(docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null) || continue
    size=$(printf '%s\n' "$listing" | awk -F'|' -v i="$id" '$1 == i { print $2; exit }')
    n_img=$((n_img + 1))
    image_lines="$image_lines$(printf '    %-40s %s' "$(printf '%s' "$ref" | cut -c1-40)" "$size")
"
  done <<< "$images"
  echo "Disk, under $STATE (and Docker):"
  printf '  %-22s %3s  %s\n' "snapshots" "$n_snap" "$(human_kb "$snap_kb_total")"
  printf '  %-22s %3s  %s\n' "dependency sets" "$n_tpl" "$(human_kb "$tpl_kb")"
  printf '  %-22s %3s  %s   (emptied above %s MB)\n' "npm download cache" "" "$(human_kb "$(size_kb "$STATE/npm-cache")")" "$NPM_CACHE_MAX_MB"
  printf '  %-22s %3s  %s\n' "seeds" "" "$(human_kb "$(size_kb "$STATE/seed")")"
  printf '  %-22s %3s  %s\n' "browser profile" "" "$(human_kb "$(size_kb "$STATE/browser-profile")")"
  printf '  %-22s %3s  (as Docker counts them; a built image includes its base)\n' "images" "$n_img"
  printf '%s' "$image_lines"
  echo ""
  echo "Limits: snapshots unused for $KEEP_DAYS day(s) are removed, and the least recently used while"
  echo "snapshots and dependency sets exceed $MAX_GB GB (SCIMGG_SANDBOX_KEEP_DAYS, SCIMGG_SANDBOX_MAX_GB)."
  echo "Dependency sets, images and game caches nothing uses go too. ./sandbox clean frees it all."
}

# ---------------------------------------------------------------------------------------------
# Preparing a snapshot

make_snapshot() {
  if [ -d "$SNAP" ] && [ "$(cat "$SNAP/format" 2>/dev/null)" != "$SNAPSHOT_FORMAT" ]; then
    PROTECTED="|$(docker ps -a --filter label=scimgg.sandbox=1 --format '{{.Label "scimgg.sandbox.sha"}}' | tr '\n' '|')"
    snap_protected "$ID" && die "containers of an older ./sandbox still use $SNAP; stop them (./sandbox stop --all) first"
    remove_tree "$SNAP"
  fi
  mkdir -p "$SNAP/vite"
  echo "$SNAPSHOT_FORMAT" > "$SNAP/format"
  touch "$SNAP/used"
  HOLD="$SNAP/hold.$$"
  : > "$HOLD"
  if [ -n "$WORKTREE_TAR" ] && [ "$WORKTREE_TAR" != "$SNAP/worktree.tar" ]; then
    [ -f "$SNAP/worktree.tar" ] || mv "$WORKTREE_TAR" "$SNAP/worktree.tar"
    WORKTREE_TAR="$SNAP/worktree.tar"
    rm -rf "$WORKTREE_PARTIAL"
    WORKTREE_PARTIAL=""
  fi
  printf '%s\n' "$SOURCE" > "$SNAP/source"
  [ -d "$TREE" ] && return 0
  local partial="$SNAP/tree.partial"
  TREE_PARTIAL=$partial
  remove_tree "$partial"
  mkdir "$partial"
  if [ -n "$WORKTREE_TAR" ]; then
    note "snapshot $ID ($SOURCE): working-tree archive"
    tar -x -C "$partial" -f "$WORKTREE_TAR"
    [ -z "$(find "$partial" ! -type f ! -type d -print)" ] || die "the working-tree archive held a non-regular file"
  else
    note "snapshot $SHA ($SOURCE): git archive"
    # No user attribute file and no LFS filter, so archiving runs nothing but git itself.
    git -C "$REPO" -c core.attributesFile=/dev/null -c filter.lfs.smudge= -c filter.lfs.process= \
      -c filter.lfs.required=false archive --format=tar "$SHA" | tar -x -C "$partial" -f -
  fi
  if [ -e "$partial/node_modules" ] || [ -L "$partial/node_modules" ]; then
    die "$SOURCE has its own node_modules; refusing it"
  fi
  # The mount point for the shared, read-only dependency set.
  mkdir "$partial/node_modules"
  mv "$partial" "$TREE"
  TREE_PARTIAL=""
}

# Stops before anything runs if the seeds lack what this command needs, and says which
# `./sandbox seed` fetches it. Only for a snapshot not yet prepared, unless SEED_CHECK_ALWAYS.
check_seeds() {
  if [ -f "$SNAP/prepared" ] && { [ "$SEED_CHECK_ALWAYS" = 0 ] || { [ "$CMD" != dev ] && [ "$CMD" != build ]; }; }; then
    return 0
  fi
  local rc=0
  run_flags
  base_flags none
  step "scimgg-sandbox-check-$SHORT" "${FLAGS[@]}" "${RUNF[@]}" --label "scimgg.sandbox.sha=$ID" \
    --mount "$(ro "$TREE" /work)" -w /work "$IMAGE" "${SEED_CHECK[@]}" "$CMD" || rc=$?
  [ "$rc" -ne 3 ] || die "the seed data above is missing. Fetch it with: ./sandbox seed${TARGET_ARGS:+ $TARGET_ARGS}"
  [ "$rc" -eq 0 ] || die "checking the seed data failed"
}

template_key() {
  regular_blob package.json
  regular_blob package-lock.json
  has_blob npm-shrinkwrap.json && die "$SHORT has an npm-shrinkwrap.json; refusing to install it"
  TEMPLATE_KEY=$(printf '%s %s %s %s\n' "$(blob package.json | sha256)" "$(blob package-lock.json | sha256)" \
    "$IMAGE" "$TEMPLATE_FORMAT" | sha256 | cut -c1-16)
  TEMPLATE="$STATE/node-modules/$TEMPLATE_KEY"
}

# node_modules is installed once per (package.json, package-lock.json, image) in a directory that
# holds only those two files, so no other code of the tree is there while the network is up or
# dependency scripts run. Snapshots then mount it read-only. It is built under a temporary name and
# renamed when complete, so an interrupted install leaves nothing a later run would use.
ensure_template() {
  if [ -d "$TEMPLATE/node_modules" ] && [ -f "$TEMPLATE/format" ]; then
    touch "$TEMPLATE/used"
    return 0
  fi
  local work="$TEMPLATE.partial.$$" key=$TEMPLATE_KEY
  TEMPLATE_PARTIAL=$work
  remove_tree "$work"
  mkdir -p "$work/build" "$STATE/npm-cache"
  blob package.json > "$work/build/package.json"
  blob package-lock.json > "$work/build/package-lock.json"

  # The checker comes from the checkout this script lives in, not from the tree under test, which
  # could have changed it to pass anything.
  [ -f "$SANDBOX_ROOT/scripts/check-lockfile.mjs" ] || die "missing $SANDBOX_ROOT/scripts/check-lockfile.mjs"
  note "lockfile check (trusted checker, no network)"
  base_flags none
  step "scimgg-sandbox-lockcheck-$key" "${FLAGS[@]}" \
    --mount "$(ro "$work/build" /build)" \
    --mount "$(ro "$SANDBOX_ROOT/scripts/check-lockfile.mjs" /trusted/check-lockfile.mjs)" \
    --mount "$(ro "$SANDBOX_ROOT/scripts/lockfileSources.mjs" /trusted/lockfileSources.mjs)" \
    "$IMAGE" node /trusted/check-lockfile.mjs /build || die "lockfile check failed; not installing"

  note "npm ci --ignore-scripts (the only step with network)"
  base_flags bridge
  step "scimgg-sandbox-install-$key" "${FLAGS[@]}" \
    --mount "$(rw "$work/build" /build)" --mount "$(rw "$STATE/npm-cache" /npm-cache)" \
    -e npm_config_cache=/npm-cache -w /build \
    "$IMAGE" npm ci --ignore-scripts --no-audit --no-fund || die "npm ci failed"

  note "npm rebuild: dependency install scripts, no network"
  base_flags none
  # Prebuilt-binary downloads fail with no network, so native modules build from source against
  # the image's own Node headers.
  step "scimgg-sandbox-rebuild-$key" "${FLAGS[@]}" \
    --mount "$(rw "$work/build" /build)" -e npm_config_nodedir=/usr/local -w /build \
    "$IMAGE" npm rebuild --foreground-scripts || die "npm rebuild failed"

  mkdir -p "$work/build/node_modules/.vite" "$work/build/node_modules/.vite-temp" "$work/build/node_modules/.cache"
  mv "$work/build/node_modules" "$work/node_modules"
  rm -rf "$work/build"
  echo "$IMAGE" > "$work/image"
  echo "$TEMPLATE_FORMAT" > "$work/format"
  size_kb "$work" > "$work/size"
  touch "$work/used"
  remove_tree "$TEMPLATE"
  mv "$work" "$TEMPLATE"
  TEMPLATE_PARTIAL=""

  # Every package in it is checked against its integrity hash, so a refetch is safe.
  if [ "$(size_kb "$STATE/npm-cache")" -gt $((NPM_CACHE_MAX_MB * 1024)) ]; then
    remove_tree "$STATE/npm-cache"
    note "emptied the npm download cache (over $NPM_CACHE_MAX_MB MB)"
  fi
}

prepare_snapshot() {
  printf '%s\n' "$TEMPLATE_KEY" > "$SNAP/template"
  [ -f "$SNAP/prepared" ] && return 0
  SNAP_PARTIAL=$SNAP
  note "preparing snapshot: seed data, then ${PREPARE_SCRIPT##*&& }"
  run_flags
  tree_flags
  base_flags none
  step "scimgg-sandbox-prepare-$SHORT" "${FLAGS[@]}" "${RUNF[@]}" "${TREEF[@]}" \
    "$IMAGE" bash -c "$PREPARE_SCRIPT" || die "preparing the snapshot failed"
  touch "$SNAP/prepared"
  SNAP_PARTIAL=""
  record_size
}

prepare() {
  target_settings
  pick_image
  template_key
  acquire_lock
  evict
  make_snapshot
  check_seeds
  ensure_template
  prepare_snapshot
  release_lock
  printf '[sandbox] %s  %s  (%s tree, Node %s)\n' "$ID" "$SOURCE" "$VARIETY" "$NODE_MAJOR" >&2
}

# One-off command in the snapshot, no network. Returns its status.
run_in_snapshot() {
  local role=$1 rc=0
  shift
  run_flags
  tree_flags
  base_flags none
  tty_flags
  docker run --rm "${FLAGS[@]}" "${RUNF[@]}" "${TREEF[@]}" ${TTY[@]+"${TTY[@]}"} \
    --name "scimgg-sandbox-$role-$SHORT" "$IMAGE" "$@" || rc=$?
  record_size
  return "$rc"
}

# `./sandbox seed`: trusted downloads (scripts/sandbox/fetch-seeds.mjs by default) in a container
# with network that has the snapshot only read-only, as data. Writes only to the seed directory.
fetch_seeds() {
  local flags=() rc=0
  target_settings
  acquire_lock
  evict
  make_snapshot
  release_lock
  mkdir -p "$STATE/seed"
  if [ "$WANT_TEST_CACHE" = 1 ]; then
    if [ -n "$(test_cache_dir)" ]; then note "test cache: $(test_cache_dir)/disk.zip is already there"
    else flags+=(--test-cache)
    fi
  fi
  ensure_pulled "$TOOLS_IMAGE"
  note "downloading what $SOURCE pins, from its pinned sources only, into $STATE/seed; nothing from the tree runs"
  base_flags bridge
  step "scimgg-sandbox-seed-$SHORT" "${FLAGS[@]}" --label "scimgg.sandbox.sha=$ID" \
    --mount "$(ro "$TREE" /work)" --mount "$(ro "$SANDBOX_ROOT/scripts/sandbox" /sandbox-tools)" \
    --mount "$(rw "$STATE/seed" /seed)" ${SEED_FLAGS[@]+"${SEED_FLAGS[@]}"} \
    "$TOOLS_IMAGE" "${SEED_FETCH[@]}" ${flags[@]+"${flags[@]}"} || rc=$?
  [ "$rc" -eq 0 ] || die "downloading the seeds failed"
}

# ---------------------------------------------------------------------------------------------
# Dev server

running() { [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = true ]; }

# Starts relay container NAME (default bridge, publishing 127.0.0.1:PORT) that forwards to TARGET on
# NET, from port START upwards. Docker refuses a port that is taken, so that is what finds a free
# one, on any host. Further arguments are extra labels. Sets RELAY_PORT.
start_relay() {
  local name=$1 target=$2 net=$3 start=$4 port=$4 tries=0 out
  shift 4
  while :; do
    docker rm -f "$name" >/dev/null 2>&1 || true
    base_flags bridge
    docker create "${FLAGS[@]}" "$@" --label scimgg.sandbox.role=proxy --label "scimgg.sandbox.port=$port" \
      --name "$name" --memory 128m --memory-swap 128m --pids-limit 64 \
      -p "127.0.0.1:$port:$port" -e SANDBOX_PORT="$port" -e SANDBOX_TARGET="$target" \
      --mount "$(ro "$SANDBOX_ROOT/scripts/sandbox/proxy.mjs" /proxy.mjs)" \
      "$TOOLS_IMAGE" node /proxy.mjs >/dev/null
    docker network connect "$net" "$name"
    if out=$(docker start "$name" 2>&1); then
      RELAY_PORT=$port
      return 0
    fi
    case "$out" in
      *"already in use"* | *"already allocated"* | *"not available"* | *"bind:"*) ;;
      *) docker rm -f "$name" >/dev/null 2>&1 || true; die "could not start the relay: $out" ;;
    esac
    tries=$((tries + 1))
    [ "$tries" -lt 30 ] || { docker rm -f "$name" >/dev/null 2>&1 || true; die "no free port in $PORT_BASE-$((PORT_BASE + PORT_SPAN - 1)) near $start"; }
    port=$((PORT_BASE + (port - PORT_BASE + 1) % PORT_SPAN))
  done
}

# Removes one dev sandbox by its short name. Returns 1 if there was none.
stop_short() {
  local short=$1 removed=1 name
  # `docker rm -f` succeeds for a missing container, so look first.
  for name in "scimgg-sandbox-dev-$short" "scimgg-sandbox-proxy-$short"; do
    if docker container inspect "$name" >/dev/null 2>&1; then docker rm -f "$name" >/dev/null; removed=0; fi
  done
  if docker network inspect "scimgg-sandbox-net-$short" >/dev/null 2>&1; then
    docker network rm "scimgg-sandbox-net-$short" >/dev/null
    removed=0
  fi
  return $removed
}

# Short names of the dev sandboxes started from the same working tree as this target, except `keep`.
worktree_sandboxes() {
  local keep=${1:-} short source
  docker ps -a --filter label=scimgg.sandbox.role=dev \
    --format '{{.Label "scimgg.sandbox.short"}}|{{.Label "scimgg.sandbox.source"}}' |
    while IFS='|' read -r short source; do
      if [ "$source" = "$SOURCE" ] && [ "$short" != "$keep" ]; then echo "$short"; fi
    done
  return 0
}

stop_target() {
  local short found=0
  if [ "$KIND" = worktree ]; then
    # The tree may have changed since its sandbox started, so match the tree, not its content.
    for short in $(worktree_sandboxes); do
      if stop_short "$short"; then echo "Stopped sandbox $short"; found=1; fi
    done
    [ "$found" = 1 ] || echo "No sandbox running for $SOURCE"
    return 0
  fi
  if stop_short "$SHORT"; then echo "Stopped sandbox $SHORT"; else echo "No sandbox running for $SHORT"; fi
}

server_ready() { curl --connect-timeout 1 --max-time 3 -fsS "http://localhost:$1/" >/dev/null 2>&1; }

# Only ever a separate profile, never the default browser or profile.
open_browser() {
  local url=$1 profile="$STATE/browser-profile" app dir bin appdata
  local chrome_exe="/mnt/c/Program Files/Google/Chrome/Application/chrome.exe"
  case "$PLATFORM" in
    wsl)
      if [ -f "$chrome_exe" ] && command -v cmd.exe >/dev/null 2>&1; then
        appdata=$( (cd /mnt/c && cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null) | tr -d '\r')
        if [[ $appdata =~ ^[A-Za-z]:\\ ]]; then
          "$chrome_exe" --user-data-dir="$appdata\\scimgg-sandbox-chrome" --no-first-run --no-default-browser-check \
            "$url" >/dev/null 2>&1 &
          return 0
        fi
      fi
      ;;
    mac)
      for app in "Google Chrome" "Chromium" "Microsoft Edge" "Brave Browser"; do
        for dir in /Applications "$HOME/Applications"; do
          if [ -d "$dir/$app.app" ]; then
            open -na "$dir/$app.app" --args --user-data-dir="$profile" --no-first-run --no-default-browser-check "$url"
            return 0
          fi
        done
      done
      ;;
  esac
  if [ "$PLATFORM" != mac ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    for bin in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge brave-browser; do
      if command -v "$bin" >/dev/null 2>&1; then
        nohup "$bin" --user-data-dir="$profile" --no-first-run --no-default-browser-check "$url" >/dev/null 2>&1 &
        return 0
      fi
    done
  fi
  echo "Open $url in a separate browser profile, not your everyday one: its page runs code you did not write."
}

start_dev() {
  if running "$APP" && running "$PROXY"; then
    RELAY_PORT=$(docker inspect -f '{{index .Config.Labels "scimgg.sandbox.port"}}' "$PROXY")
    note "reusing the running sandbox"
  else
    stop_short "$SHORT" || true
    if [ "$KIND" = worktree ]; then
      # Like `npm run dev`, one server per working tree: an edit replaces the server for the old content.
      local old
      for old in $(worktree_sandboxes "$SHORT"); do
        if stop_short "$old"; then note "stopped $old, started from earlier content of this tree"; fi
      done
    fi
    local labels=(--label "scimgg.sandbox.sha=$ID" --label "scimgg.sandbox.short=$SHORT"
      --label "scimgg.sandbox.source=$SOURCE")
    # --internal alone still gives the host an address on the bridge, through which the app could
    # reach every host service listening on 0.0.0.0. inhibit_ipv4 leaves the host none.
    docker network create --internal -o com.docker.network.bridge.inhibit_ipv4=true \
      --label scimgg.sandbox=1 "$NET" >/dev/null
    # The relay first: the port it gets is the one Vite must serve on, for HMR.
    start_relay "$PROXY" "$APP" "$NET" $((PORT_BASE + $(printf '%s' "$ID" | cksum | cut -d' ' -f1) % PORT_SPAN)) "${labels[@]}"

    run_flags
    tree_flags
    base_flags "$NET"
    # SCIM_DEV_LAN=1 makes Vite bind every interface of this container, whose only network is the
    # internal one; the host side is the relay's 127.0.0.1 binding.
    docker run -d "${FLAGS[@]}" "${RUNF[@]}" "${TREEF[@]}" "${labels[@]}" --label scimgg.sandbox.role=dev \
      --label "scimgg.sandbox.port=$RELAY_PORT" --name "$APP" -e SCIM_DEV_LAN=1 \
      "$IMAGE" npx vite --host 0.0.0.0 --port "$RELAY_PORT" --strictPort >/dev/null

    local attempts=0
    until server_ready "$RELAY_PORT"; do
      if ! running "$APP"; then
        docker logs --tail 40 "$APP" >&2 || true
        stop_target >/dev/null
        die "the dev server exited; see the log above"
      fi
      attempts=$((attempts + 1))
      [ $attempts -lt 240 ] || die "timed out waiting for the dev server; docker logs $APP"
      sleep 0.5
    done
  fi

  local url="http://localhost:$RELAY_PORT"
  echo ""
  echo "  Commit:  $SHA${WORKTREE_TAR:+ plus working-tree changes (snapshot $ID)}"
  echo "  Source:  $SOURCE"
  echo "  URL:     $url"
  echo "  Log:     docker logs -f $APP"
  echo "  Stop:    ./dev-sandbox ${TARGET_ARGS:+$TARGET_ARGS }--stop"
  echo "  Access:  127.0.0.1 only; the app container has no network."
  echo ""
  [ "$NO_OPEN" = 1 ] || open_browser "$url"
}

show_status() {
  echo "Sandboxes:"
  echo ""
  local rows others snap name
  rows=$(docker ps -a --filter label=scimgg.sandbox.role=dev \
    --format '{{.State}}|{{.Label "scimgg.sandbox.port"}}|{{.Label "scimgg.sandbox.sha"}}|{{.Label "scimgg.sandbox.source"}}')
  if [ -z "$rows" ]; then
    echo "  no dev servers"
  else
    while IFS='|' read -r state port sha source; do
      local mark="○ $state"
      [ "$state" = running ] && mark="● running"
      printf "  %-12s  :%-5s  %s  %s\n" "$mark" "$port" "${sha:0:12}${sha:40:26}" "$source"
    done <<< "$rows"
  fi
  others=$(docker ps -a --filter label=scimgg.sandbox=1 --format '{{.Names}}' | grep -v -e '-dev-' -e '-proxy-' || true)
  if [ -n "$others" ]; then
    printf '\n  other sandbox containers:\n'
    printf '%s\n' "$others" | sed 's/^/    /'
  fi
  echo ""
  if [ -d "$STATE/snapshots" ]; then
    for snap in "$STATE"/snapshots/*/; do
      [ -d "$snap" ] || continue
      name=$(basename "$snap")
      printf "  snapshot %s  %-8s %s%s\n" "${name:0:12}${name:40:26}" "$(human_kb "$(snap_kb "${snap%/}")")" \
        "$(cat "$snap/source" 2>/dev/null || echo '?')" "$([ -f "$snap/prepared" ] || echo ' (not prepared)')"
    done
    echo ""
  fi
  disk_report
  echo ""
}

stop_all() {
  local ids nets
  ids=$(docker ps -aq --filter label=scimgg.sandbox=1)
  # shellcheck disable=SC2086 # container ids are hex words
  [ -z "$ids" ] || docker rm -f $ids >/dev/null
  nets=$(docker network ls -q --filter label=scimgg.sandbox=1)
  # shellcheck disable=SC2086 # network ids are hex words
  [ -z "$nets" ] || docker network rm $nets >/dev/null
  echo "Stopped every sandbox"
}

clean() {
  local what=$1 snap ref repo
  case "$what" in
    target)
      stop_target >/dev/null
      if [ "$KIND" = worktree ]; then
        for snap in "$STATE"/snapshots/*-worktree-*/; do
          [ "$(cat "$snap/source" 2>/dev/null)" = "$SOURCE" ] || continue
          remove_tree "$snap"
          echo "Removed snapshot $(basename "$snap")"
        done
      else
        remove_tree "$SNAP"
        echo "Removed snapshot $SHORT"
      fi
      ;;
    snapshots | all)
      stop_all
      remove_tree "$STATE/snapshots"
      remove_tree "$STATE/node-modules"
      remove_tree "$STATE/tmp"
      if [ "$what" = all ]; then
        remove_tree "$STATE/npm-cache"
        remove_tree "$STATE/seed"
        remove_tree "$STATE/selftest"
        remove_tree "$STATE/browser-profile"
        ID="" IMAGE="" NODE_IMAGES="" TOOLS_IMAGE="" SANDBOX_DOCKERFILE=""
        evict_images
        remove_tree "$STATE"
        repo=$(current_repo 2>/dev/null || true)
        if [ -n "$repo" ]; then
          git -C "$repo" for-each-ref --format='%(refname)' refs/sandbox/ | while IFS= read -r ref; do
            git -C "$repo" update-ref -d "$ref"
          done
        fi
        echo "Removed everything under $STATE, this script's images and refs/sandbox/ in $repo"
      else
        echo "Removed snapshots and installed dependencies under $STATE (kept the npm download cache and seeds)"
      fi
      ;;
  esac
}

# ---------------------------------------------------------------------------------------------
# Arguments

if [ -f "$SANDBOX_ROOT/scripts/sandbox/local.sh" ]; then
  # shellcheck source=/dev/null # a fork's own extension; see "Local extensions" above
  . "$SANDBOX_ROOT/scripts/sandbox/local.sh"
fi

# Everything runs from inside main, which bash has read in full before it starts, so replacing this
# file during a long test run cannot make the running copy read a half-changed script.
main() {
  CMD=${1:-}
  [ -n "$CMD" ] || { usage; exit 64; }
  shift
  local kind=commit spec=HEAD action=""
  NO_OPEN=0 ALL=0 TARGET_ARGS="" TARGET_GIVEN=0 WANT_TEST_CACHE=0 VARIETY="" KIND=commit IMAGE=""
  EXTRA=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --pr) [ $# -ge 2 ] || die "--pr needs a number"; kind=pr spec=$2 TARGET_ARGS="--pr $2" TARGET_GIVEN=1; shift 2 ;;
      --worktree) kind=worktree TARGET_ARGS="--worktree" TARGET_GIVEN=1; shift ;;
      --stop) action=stop; shift ;;
      --status) action=status; shift ;;
      --no-open) NO_OPEN=1; shift ;;
      --all) ALL=1; shift ;;
      --test-cache) WANT_TEST_CACHE=1; shift ;;
      --) shift; EXTRA=("$@"); break ;;
      -h | --help) action=help; shift ;;
      -*) die "unknown option '$1'; see ./sandbox --help" ;;
      *) [ "$TARGET_GIVEN" = 0 ] || die "only one TARGET"; spec=$1 TARGET_ARGS=$1 TARGET_GIVEN=1; shift ;;
    esac
  done
  case "$CMD" in
    -h | --help | help) usage; exit 0 ;;
    dev | test | build | shell | seed | selftest | status | stop | clean) ;;
    *) die "unknown command '$CMD'; see ./sandbox --help" ;;
  esac
  if [ "$action" = help ]; then
    if [ "$CMD" = dev ]; then dev_usage; else usage; fi
    exit 0
  fi

  detect_platform
  [ "$HOST_UID" -ne 0 ] || die "run as your normal user, not root"
  read_limits
  preflight_host
  preflight_docker
  ensure_identity
  case "$CMD" in
    status | stop | clean) ;;
    dev) [ "$action" = stop ] || [ "$action" = status ] || selftest ;;
    selftest) selftest 1; exit 0 ;;
    *) selftest ;;
  esac

  local rc=0
  case "$CMD" in
    dev)
      case "$action" in
        status) show_status ;;
        stop) resolve_target "$kind" "$spec" local; stop_target ;;
        *) resolve_target "$kind" "$spec"; prepare; start_dev ;;
      esac
      ;;
    test)
      resolve_target "$kind" "$spec"; prepare
      run_in_snapshot test npm test ${EXTRA[@]+-- "${EXTRA[@]}"} || rc=$?
      ;;
    build)
      resolve_target "$kind" "$spec"; prepare
      run_in_snapshot build bash -c "$BUILD_SCRIPT" build ${EXTRA[@]+"${EXTRA[@]}"} || rc=$?
      echo "[sandbox] build output: $TREE/dist (written by sandboxed code; treat it as untrusted)"
      ;;
    shell)
      resolve_target "$kind" "$spec"; prepare
      if [ ${#EXTRA[@]} -gt 0 ]; then run_in_snapshot shell "${EXTRA[@]}" || rc=$?
      else run_in_snapshot shell bash || rc=$?
      fi
      ;;
    seed) resolve_target "$kind" "$spec"; fetch_seeds ;;
    status) show_status ;;
    stop)
      if [ "$ALL" = 1 ]; then stop_all; else resolve_target "$kind" "$spec" local; stop_target; fi
      ;;
    clean)
      if [ "$ALL" = 1 ]; then clean all
      elif [ "$TARGET_GIVEN" = 1 ]; then resolve_target "$kind" "$spec" local; clean target
      else clean snapshots
      fi
      ;;
  esac
  return "$rc"
}

main "$@"; exit
