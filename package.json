{
  "name": "scimgg",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone OSRS combat practice simulator",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "predev": "tsx scripts/setupOutputs.ts",
    "dev": "vite",
    "build": "tsx scripts/check-licenses.ts && tsx scripts/setup.ts --check && vite build && tsx scripts/check-trimmed-cache.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/core/combat src/data src/types src/util src/encounters src/render/core src/render/projections src/tutorial/content --exclude '**/*.integration.test.ts' --exclude 'src/data/__tests__/specialAttacks.test.ts'",
    "test:integration": "vitest run src/__tests__/debugSpawnButtons.integration.test.ts src/__tests__/perfectDodge.integration.test.ts src/data/__tests__/specialAttacks.test.ts",
    "typecheck": "tsc -b",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:cache-runtime": "vitest run --config scripts/cache-runtime.vitest.config.ts"
  },
  "dependencies": {
    "@foxglove/wasm-bz2": "0.3.0",
    "driver.js": "1.4.0",
    "gl-matrix": "^3.4.4",
    "jszip": "^3.10.2",
    "pako": "^3.0.3",
    "picogl": "^0.17.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "vite": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@biomejs/biome": "2.4.8",
    "@google/design.md": "0.4.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/pako": "^3.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stats.js": "^0.17.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "puppeteer": "^25.18.1",
    "sharp": "^0.35.5",
    "stats.js": "^0.17.0",
    "tweakpane": "^4.0.5",
    "typescript": "^7.0.2",
    "vite-plugin-glsl": "^1.6.3",
    "vitest": "^5.1.1",
    "webgl-lint": "^1.11.4"
  }
}
